# enemy - противник; position - необязательная позиция нашего героя.
PREFIX kg: <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/ontology#>
PREFIX fn: <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/function/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?hero ?name ?score ?source ?ability ?mechanic ?rule ?targetMechanic ?targetFact
WHERE {
  # Отсекаем кандидатов без основания до соединения с объясняющими фактами.
  { SELECT ?hero ?enemy ?name ?score ?effect ?rule ?targetFact WHERE {
    ?hero a kg:Hero ; rdfs:label ?name .
    ?enemy a kg:Hero .
    FILTER (?hero != ?enemy)
    FILTER (!BOUND(?position) || EXISTS { ?hero kg:mostPopularPosition|kg:secondMostPopularPosition ?position })
    BIND (fn:score(?hero, ?enemy) AS ?score)
    BIND (fn:effect(?hero, ?enemy) AS ?effect)
    BIND (fn:rule(?hero, ?enemy) AS ?rule)
    BIND (fn:target(?hero, ?enemy) AS ?targetFact)
    FILTER (BOUND(?score) && BOUND(?effect))
  } }
  FILTER (EXISTS { ?hero kg:hasAbility ?source } || EXISTS { ?source a kg:Item })
  ?source rdfs:label ?ability ; kg:hasEffect ?effect .
  ?effect kg:effectMechanic ?mechanic .
  ?rule kg:sourceMechanic ?mechanic ; kg:targetMechanic ?targetMechanic ; kg:ruleWeight ?weight .
  ?targetFact kg:effectMechanic ?targetMechanic .
  FILTER (EXISTS { ?enemy kg:hasAbility/kg:hasEffect ?targetFact }
       || EXISTS { ?enemy kg:hasEffect ?targetFact }
       || EXISTS { ?enemySource a kg:Item ; kg:hasEffect ?targetFact })
}
ORDER BY DESC(?score) ?hero
LIMIT 10
