<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/item/158/note/note/1> a kg:GameNote ;
    rdfs:label "Mjollnir: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Static Charge's shock deals magical damage centered on hero with the Static Charge. Static Charge's targets cannot be more than %static_seconary_radius% range away."^^xsd:string ;
    kg:position 1 .

