<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/6343/note/0> a kg:GameNote ;
    rdfs:label "Rolling Thunder: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Enemies can be stunned multiple times per use, but cannot be affected a subsequent time until the previous stun duration ends."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/6343/note/1> a kg:GameNote ;
    rdfs:label "Rolling Thunder: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "If Pangolier is disabled while rolling, he will continue to stun and knock enemies that come within range."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/6343/note/2> a kg:GameNote ;
    rdfs:label "Rolling Thunder: примечание 3"^^xsd:string ;
