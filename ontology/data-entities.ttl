<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5103/note/0> a kg:GameNote ;
    rdfs:label "Sand Storm: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Sand Storm can be used to dodge projectiles."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5103/note/1> a kg:GameNote ;
    rdfs:label "Sand Storm: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Sand King briefly becomes visible upon attacking or using spells while in Sand Storm. Sand King will become invisible again in %fade_delay% seconds."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5103/note/facet/0> a kg:GameNote ;
    rdfs:label "Sand Storm: аспект 1"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Sand Storm has increased radius and grants Sand King Invisibility while in it."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5103/note/facet/1> a kg:GameNote ;
    rdfs:label "Sand Storm: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Sand Storm follows Sand King at a rate of %sand_storm_move_speed_pct%%% of his movement speed and is still active at a distance of up to %sand_storm_max_distance_from_caster% units away from Sand King."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5103/note/facet/2> a kg:GameNote ;
    rdfs:label "Sand Storm: аспект 3"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "When Sand King attacks enemies in Sand Storm, he applies a blinding debuff to the target."^^xsd:string ;
    kg:position 2 .

