<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/6583> a kg:Ability ;
    rdfs:label "Spear of Mars"^^xsd:string ;
    kg:behavior "1040"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Mars throws his legendary Spear with deadly precision, damaging each enemy unit it strikes. The first enemy hero it hits is skewered on the spear, pushing it back. If a skewered hero hits a tree, building, or cliff, they will be impaled to it and stunned."^^xsd:string ;
