<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5512/note/0> a kg:GameNote ;
    rdfs:label "Battle Trance: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Troll can still use his items and abilities while affected by Battle Trance, but not other commands."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5512/note/1> a kg:GameNote ;
