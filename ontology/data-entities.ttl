<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5119> a kg:Ability ;
    rdfs:label "Kraken Shell"^^xsd:string ;
    kg:behavior "2052"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Thickens Tidehunter's hide to passively block a portion of any incoming physical attack damage. Reduced block amount versus creeps. The hide also removes negative status effects if the damage taken crosses a threshold. Can be activated to double the block amount at the cost of %active_move_speed_penalty_pct%%% movement speed. Lasts %active_duration%s. DISPEL TYPE: Strong Dispel"^^xsd:string ;
    kg:dispelType "Strong"^^xsd:string ;
    kg:dispellableCode 3 ;
    kg:grantedByScepter false ;
