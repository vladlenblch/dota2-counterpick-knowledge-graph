<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5330/note/0> a kg:GameNote ;
    rdfs:label "Holy Persuasion: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Persuading a new creep above max unit count causes the oldest persuaded creep to die."^^xsd:string ;
