<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5488/note/0> a kg:GameNote ;
    rdfs:label "Relocate: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Enemies receive a visual indicator in the world and on the minimap of the target location during the cast delay."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5488/note/1> a kg:GameNote ;
    rdfs:label "Relocate: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "If Io is disabled during the cast delay, Relocate is cancelled."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5488/note/2> a kg:GameNote ;
    rdfs:label "Relocate: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "If an allied hero is Tethered, that hero will teleport along with you. You can break the tether at any time to prevent that hero from teleporting with you."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5488/note/3> a kg:GameNote ;
    rdfs:label "Relocate: примечание 4"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Only heroes, creep heroes, and illusions can be relocated."^^xsd:string ;
    kg:position 3 .

