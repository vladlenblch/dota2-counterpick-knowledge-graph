<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5069> a kg:Ability ;
    rdfs:label "Illusory Orb"^^xsd:string ;
    kg:behavior "1099511627792"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Vector Targeted. Puck launches a magic orb that travels along the path, damaging enemy units along the way. The orb deals an additional %damage_over_time_pct%%% of its impact damage every %damage_interval%s in its area of effect, but if it exceeds the max cast range it will be destroyed. At any point, Puck may teleport to the orb's location using Ethereal Jaunt. Can be put on alt-cast to launch the Orb straight ahead."^^xsd:string ;
    kg:dispellableCode 0 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5069/parameter/17>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5069/parameter/cast_point> ;
