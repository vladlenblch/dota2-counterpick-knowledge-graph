<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8429/note/0> a kg:GameNote ;
    rdfs:label "Acorn Shot: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "The same target can be hit more than once."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8429/note/1> a kg:GameNote ;
    rdfs:label "Acorn Shot: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Bounces will seek units in the fog of war in a 525 radius, but not invisible units."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8429/note/2> a kg:GameNote ;
    rdfs:label "Acorn Shot: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "The planted tree lasts for 20 seconds."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8429/note/facet/1> a kg:GameNote ;
    rdfs:label "Acorn Shot: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "If there are no bounce targets within range of Acorn Shot, it can bounce off a nearby tree and set the remaining number of bounces to %bounces_after_tree_bounce%."^^xsd:string ;
    kg:position 1 .

