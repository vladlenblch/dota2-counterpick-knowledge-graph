<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5588/note/0> a kg:GameNote ;
    rdfs:label "Borrowed Time: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Borrowed Time can be manually activated while Abaddon is disabled, but not while silenced.  The passive activation can still occur while silenced."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5588/note/1> a kg:GameNote ;
    rdfs:label "Borrowed Time: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Aphotic Shield does not block any damage to Abaddon when Borrowed Time is active, allowing him to heal."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5588/note/2> a kg:GameNote ;
    rdfs:label "Borrowed Time: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Break prevents Borrowed Time from automatically activating."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5588/note/facet/1> a kg:GameNote ;
    rdfs:label "Borrowed Time: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "While Borrowed Time is active, Abaddon and enemies within %immolate_aoe% radius take %immolate_damage% damage per second."^^xsd:string ;
    kg:position 1 .

