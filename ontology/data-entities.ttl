<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1550> a kg:Ability ;
    rdfs:label "Nothl Projection"^^xsd:string ;
    kg:behavior "16"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Dazzle departs his body, traveling through the Nothl Realm as an invulnerable spirit that can cast spells, attack, and use items, leaving his body behind in the world with a visible tether. While active, Dazzle's basic abilities are empowered: Poison Touch hexes enemies, Shallow Grave heals upon expiration, and Shadow Wave has a shorter cooldown. The effect can be ended early, and Dazzle returns to the body at the end."^^xsd:string ;
    kg:dispellableCode 3 ;
    kg:grantedByScepter false ;
