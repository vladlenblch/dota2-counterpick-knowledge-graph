<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/6343> a kg:Ability ;
    rdfs:label "Rolling Thunder"^^xsd:string ;
    kg:behavior "134742020"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Physical"^^xsd:string ;
    kg:damageTypeCode 1 ;
    kg:description "Pangolier curls into a debuff immune ball with %magic_resistance%%% magic resistance and rolls out. When rolling, he moves at an increased speed and can move through trees, but has a decreased ability to turn. Striking enemies knocks them back, inflicting damage proportional to his attack damage and stunning them when they land. Colliding with walls or cliffs will cause a temporary pause while Pangolier reverses in direction. DISPEL TYPE: Basic Dispel"^^xsd:string ;
    kg:dispelType "Basic"^^xsd:string ;
    kg:dispellableCode 3 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/6343/parameter/16> ;
