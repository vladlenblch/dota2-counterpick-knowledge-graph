<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5435/note/facet/1> a kg:GameNote ;
    rdfs:label "Leech Seed: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Leech Seed can be ground targeted, planting a tree that heals allies and damages all enemies in the effect radius for the duration of the ability. Damage to creeps is reduced by %creep_damage_reduction_pct%%%. If the tree is cut down, it immediately re-grows again."^^xsd:string ;
    kg:position 1 .

