<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5280> a kg:Ability ;
    rdfs:label "Spin Web"^^xsd:string ;
    kg:behavior "48"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Spins a large web that grants Broodmother a passive movement speed increase and increases her Turn Rate, while in its vicinity, as well as giving free movement. Spin Web can be cast from anywhere as long as the new web touches an existing web. Webs never expire, and can be manually destroyed. When the maximum limit of webs is exceeded, the oldest web disappears."^^xsd:string ;
    kg:dispellableCode 3 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5280/parameter/7> ;
    kg:hasCastRange <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5280/parameter/6> ;
    kg:hasCooldown <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5280/parameter/cooldown> ;
    kg:hasManaCost <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5280/parameter/10> ;
