    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/71> ;
    kg:identifier 5355 ;
    kg:immunityCode 3 ;
    kg:internalName "spirit_breaker_greater_bash"^^xsd:string ;
    kg:isInnate false ;
    kg:isUltimate false ;
    kg:maxLevel 4 ;
    kg:piercesDebuffImmunity true ;
    kg:scepterDescription "Increases knockback. If a knocked-back enemy collides with another enemy, the second enemy is bashed (creeps only receive %cascading_bashes_creep_penalty%%% damage), and the original target takes %cascading_bashes_damage_multiplier%%% of Greater Bash's damage again."^^xsd:string ;
    kg:targetTeam 0 ;
    kg:targetType 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5355/note/0> a kg:GameNote ;
    rdfs:label "Greater Bash: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Does not stack with Skull Basher."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5355/note/1> a kg:GameNote ;
    rdfs:label "Greater Bash: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Break disables the passive percent Chance to Bash. Does not disable Greater Bash application from Charge of Darkness or Nether Strike."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5355/note/facet/2> a kg:GameNote ;
    rdfs:label "Greater Bash: аспект 3"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Greater Bash chance is increased if you've bashed more than one hero within the last %bonus_chance_duration%s. Each additional hero past the first increases Greater Bash chance by %bonus_chance_pct%%%."^^xsd:string ;
    kg:position 2 .

