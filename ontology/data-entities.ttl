    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Grants bonus movement speed when near trees. Treant Protector additionally has Tree Walking if he has not taken damage for %cooldown_time% seconds. While Tree Walking, Nature's Guise can be activated to grant Treant invisibility until he attacks or is no longer near a tree."^^xsd:string ;
    kg:dispellableCode 0 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5434/parameter/cast_point> ;
