<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5485/note/0> a kg:GameNote ;
    rdfs:label "Tether: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "If you try to tether a unit that is 700 distance or further away from Io, Io will latch on and pull itself closer to the tethered unit (to a distance of 300)."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5485/note/1> a kg:GameNote ;
    rdfs:label "Tether: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "The tethered unit will heal faster and will heal even if Io is at full health."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5485/note/2> a kg:GameNote ;
    rdfs:label "Tether: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Io's movement speed matches the tethered unit's."^^xsd:string ;
    kg:position 2 .

