    rdfs:label "Rolling Boulder: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Stone Remnants are not destroyed when rolled over, and the cooldown of Stone Remnant is refreshed when the roll is done."^^xsd:string ;
