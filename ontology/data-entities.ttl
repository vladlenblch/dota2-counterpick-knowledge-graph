<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1342/note/0> a kg:GameNote ;
    rdfs:label "Summon Spirit Bear: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Most spells interact with the Spirit Bear in the same way as they do with heroes."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1342/note/1> a kg:GameNote ;
    rdfs:label "Summon Spirit Bear: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Spirit Bear has 0 base attributes, 0 base armor, and %base_magic_resistance%%% base magic resistance. Attributes from buffs or items fully affect the bear as they would for Universal heroes."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1342/note/2> a kg:GameNote ;
    rdfs:label "Summon Spirit Bear: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Spirit Bear cannot gain experience. The Spirit Bear levels up when Lone Druid levels up."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1342/note/3> a kg:GameNote ;
    rdfs:label "Summon Spirit Bear: примечание 4"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Spirit Bear has its own Aghanim's Scepter and Shard upgrades."^^xsd:string ;
    kg:position 3 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1342/note/4> a kg:GameNote ;
    rdfs:label "Summon Spirit Bear: примечание 5"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Spirit Bear receives a copy of Lone Druid's Neutral Item that has an independent cooldown."^^xsd:string ;
    kg:position 4 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1342/note/facet/1> a kg:GameNote ;
    rdfs:label "Summon Spirit Bear: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Increases the distance from Lone Druid at which the Spirit Bear can attack."^^xsd:string ;
    kg:position 1 .

