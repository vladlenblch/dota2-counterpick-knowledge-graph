    kg:internalName "shadow_shaman_fowl_play"^^xsd:string ;
    kg:isInnate true ;
    kg:isUltimate false ;
    kg:maxLevel 1 ;
    kg:shardDescription "Increases the amount of time incoming damage is reduced to %damage_reduction_duration% seconds. When Fowl Play is triggered, Shadow Shaman becomes invulnerable for %invuln_duration% seconds. %chicken_illusions% additional uncontrollable chickens are created that last for %ally_voodoo_duration% seconds. While Shadow Shaman is transformed, he can now use items."^^xsd:string ;
    kg:targetTeam 0 ;
    kg:targetType 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1250/note/0> a kg:GameNote ;
    rdfs:label "Fowl Play: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Lethal Damage from Axe's Culling Blade and Necrophos's Reaper's Scythe will not be prevented."^^xsd:string ;
    kg:position 0 .

