<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5334> a kg:Ability ;
    rdfs:label "Spectral Dagger"^^xsd:string ;
    kg:behavior "24"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Spectre flings a dagger to draw a Shadow Path, dealing damage and slowing the movement speed of any enemies along the trail. Units hit by the dagger also trail a Shadow Path. While treading the path, Spectre moves faster and phases through otherwise impassable terrain."^^xsd:string ;
