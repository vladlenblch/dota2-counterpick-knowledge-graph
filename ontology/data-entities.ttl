    rdfs:label "Crystal Clone"^^xsd:string ;
    kg:behavior "8762165265"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Slides in a direction, creating a crystal clone of herself in her place and disjointing incoming projectiles. If the clone takes enough damage or times out, it shatters, Frostbiting enemies in a %frostbite_radius% AoE around its place. The Clone can also be destroyed by Crystal Maiden's own spells."^^xsd:string ;
    kg:dispellableCode 0 ;
