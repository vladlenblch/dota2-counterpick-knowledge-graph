<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8028> a kg:Ability ;
    rdfs:label "Ice Spire"^^xsd:string ;
    kg:behavior "8724152369"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Creates an Ice Spire at the target spot, slowing enemies around it. Can take %max_hero_attacks% hero hits or %max_creep_attacks% creep hits and when destroyed it will create a Frost Blast around it. Chain Frost can be cast on the Spire and can bounce to the Spire and damage the spire by 1 hero attack if there are no other enemies in range. Lich can cast Frost Shield on the Spire. Each Frost Shield tick will heal the spire by 1 hero attack."^^xsd:string ;
    kg:dispellableCode 3 ;
    kg:grantedByScepter false ;
    kg:grantedByShard true ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8028/parameter/7> ;
