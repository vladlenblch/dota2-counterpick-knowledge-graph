<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1684/note/0> a kg:GameNote ;
    rdfs:label "Entangle: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Rooted units can't use Blink abilities and are revealed if they are invisible."^^xsd:string ;
    kg:position 0 .

