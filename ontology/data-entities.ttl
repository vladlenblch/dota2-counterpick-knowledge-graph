    kg:behavior "33816580"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Physical"^^xsd:string ;
    kg:damageTypeCode 1 ;
    kg:description "Templar Assassin conceals herself, becoming invisible as long as she remains still. If Meld's invisibility is broken by attacking an enemy, Lanaya's attack will deal bonus damage to the enemy and reduce their armor for %debuff_duration% seconds. Bonus damage and debuffs from Meld are applied to all enemies in the Psi Blades split range."^^xsd:string ;
