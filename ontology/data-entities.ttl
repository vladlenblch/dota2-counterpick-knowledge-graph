<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5275/note/0> a kg:GameNote ;
    rdfs:label "Void: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Void does not ministun enemies during the day."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5275/note/facet/0> a kg:GameNote ;
    rdfs:label "Void: аспект 1"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Enemies affected by Void do not share vision with their allies. Affected enemies take damage per second when they are not visible to their allies."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5275/note/facet/2> a kg:GameNote ;
    rdfs:label "Void: аспект 3"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Increases the max level of Void. Level %max_level% Void at night becomes ground targeted, increases movement and attack slow, and applies to a %cast_radius_tooltip% AoE."^^xsd:string ;
    kg:position 2 .

