<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5754> a kg:Ability ;
    rdfs:label "Pierce the Veil"^^xsd:string ;
    kg:behavior "4"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Muerta transforms, becoming ethereal, gaining bonus base damage and phased movement. Passively allows Muerta to always attack ethereal targets and attack when she is ethereal. When either she or her target is ethereal, all of her attack damage is dealt as magical damage and her physical lifesteal is treated as spell lifesteal. DISPEL TYPE: Basic Dispel"^^xsd:string ;
    kg:dispelType "Basic"^^xsd:string ;
    kg:dispellableCode 3 ;
    kg:grantedByScepter false ;
