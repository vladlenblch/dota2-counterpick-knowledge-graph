<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1216> a kg:Ability ;
    rdfs:label "Feast of Souls"^^xsd:string ;
    kg:behavior "2052"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Shadow Fiend gains Bonus Movement and Attack Speed for %duration% seconds. For the duration of the effect, every %soul_collection_interval%s he collects souls from %soul_collection_per_interval% enemies in a %soul_collection_radius% radius. After the effect is over, he loses the souls whose owners are still alive, retaining the rest for %linger_duration%s, after which souls that are over the Necromastery max stack count are also lost. Can only collect souls once from each individual enemy."^^xsd:string ;
    kg:dispellableCode 2 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1216/parameter/cast_point> ;
    kg:hasCastRange <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1216/parameter/cast_range> ;
    kg:hasCooldown <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1216/parameter/13> ;
