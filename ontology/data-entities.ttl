    kg:internalName "chaos_knight_reality_rift"^^xsd:string ;
    kg:isInnate false ;
    kg:isUltimate false ;
    kg:maxLevel 4 ;
    kg:shardDescription "Allows Reality Rift to be cast on any enemy hero that is within 1200 range of you or one of your illusions. Gathers all of your illusions and your hero and teleports them to the target enemy."^^xsd:string ;
    kg:targetTeam 2 ;
    kg:targetType 19 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5427/note/0> a kg:GameNote ;
    rdfs:label "Reality Rift: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Chaos Knight and the target unit are made to face each other, and Chaos Knight and his phantasms are issued an attack order against the target."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5427/note/facet/1> a kg:GameNote ;
    rdfs:label "Reality Rift: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Reality Rift has equal chances of applying Break, Disarm, or Silence for %additional_debuff_duration_percent%%% of the base debuff duration in addition to its normal effects."^^xsd:string ;
