<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5691/note/1> a kg:GameNote ;
    rdfs:label "Time Dilation: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Number of stacks can change during the effect. Casting an ability will provide a stack if it goes on cooldown. If an ability cooldown ends during Time Dilation, a stack will be removed."^^xsd:string ;
