<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5248> a kg:Ability ;
    rdfs:label "Wrath of Nature"^^xsd:string ;
    kg:behavior "24"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Damaging energy bounces around the map, striking enemies that are in vision starting with those closest to the cast point. Each enemy hit beyond the first adds damage, up to the maximum after %max_targets% are hit."^^xsd:string ;
