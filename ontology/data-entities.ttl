    rdfs:label "Smoke of Deceit"^^xsd:string ;
    kg:behavior "33554436"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:cost 50 ;
    kg:damageTypeCode 0 ;
    kg:description "Use: Disguise Turns the caster and all allied player-controlled targets in a %application_radius% radius invisible, and grants %bonus_movement_speed%%% bonus movement speed for %duration% seconds. While the caster is still disguised, any allies that come within %secondary_application_radius% range of them will also get the buff applied to them. Each smoke can only be applied once to allies. Attacking or moving within %visibility_radius% range of an enemy hero or tower, will break the invisibility. Disguise grants invisibility that is immune to True Sight. Smoke of Deceit is usable from the backpack and has no cooldown when swapped into the main inventory."^^xsd:string ;
    kg:dispellableCode 0 ;
    kg:hasBonusParameter <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/item/188/parameter/2> ;
