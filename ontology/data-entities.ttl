<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7906> a kg:Ability ;
    rdfs:label "Solar Guardian"^^xsd:string ;
    kg:behavior "144"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "CHANNELED - Dawnbreaker creates a pulsing effect at a location within %max_offset_distance% units of an allied hero anywhere on the map and creates daylight for %daytime_duration%s. Each pulse damages enemies and heals allies. After a short duration, she flies to the target location and deals additional damage and stuns enemies upon landing. Once channeled, Dawnbreaker cannot stop the ability."^^xsd:string ;
    kg:dispellableCode 0 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7906/parameter/15>,
