<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5288/note/0> a kg:GameNote ;
    rdfs:label "Track: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Bounty Hunter will get the bonus gold if the target dies while Track is active, regardless of how it died."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5288/note/1> a kg:GameNote ;
    rdfs:label "Track: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Track's effect is only visible to allies."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5288/note/2> a kg:GameNote ;
    rdfs:label "Track: примечание 3"^^xsd:string ;
