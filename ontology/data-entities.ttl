<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5586/note/0> a kg:GameNote ;
    rdfs:label "Aphotic Shield: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "The max damage is always dealt whether the barrier is destroyed by expiring or absorbing damage."^^xsd:string ;
