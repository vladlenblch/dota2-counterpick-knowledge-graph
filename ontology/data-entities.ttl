        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5427/parameter/5>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5427/parameter/6>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5427/parameter/7> ;
