<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5189> a kg:Ability ;
    rdfs:label "Life Drain"^^xsd:string ;
    kg:behavior "134217864"^^xsd:string ;
    kg:behaviorFlags 384 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "CHANNELED - When cast on an enemy, Pugna drains health from the target enemy unit to heal himself and granting vision over the target. When cast on an ally, Pugna will drain his own health into his ally."^^xsd:string ;
    kg:dispellableCode 3 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5189/parameter/13>,
