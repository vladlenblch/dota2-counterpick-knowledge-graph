    kg:isUltimate false ;
    kg:maxLevel 4 ;
    kg:scepterDescription "Adds active ability to Bristleback. Bristleback rotates towards the targeted direction and, after %activation_delay%s, forcefully ejects %activation_num_quill_sprays% sequential Quill Sprays in a tight conical pattern out of his back every %activation_spray_interval%s. Bristleback's facing is locked during this time, he is disarmed, and his speed is reduced by %activation_movement_speed_pct%%%."^^xsd:string ;
    kg:targetTeam 0 ;
    kg:targetType 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5550/note/0> a kg:GameNote ;
    rdfs:label "Bristleback: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Bristleback's rear is considered to be within 70 degrees from the back."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5550/note/1> a kg:GameNote ;
    rdfs:label "Bristleback: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Bristleback's side is considered to be within 110 degrees from the back."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5550/note/2> a kg:GameNote ;
    rdfs:label "Bristleback: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Damage done by Quill Sprays released by this ability passively is considered reflected damage. Reflected damage does not provide any lifesteal and cannot be reflected."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5550/note/facet/1> a kg:GameNote ;
    rdfs:label "Bristleback: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Instead of releasing Quill Spray from taking damage, he instead launches Nasal Goo of the current level at all nearby enemies."^^xsd:string ;
    kg:position 1 .

