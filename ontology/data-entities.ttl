<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5289/note/0> a kg:GameNote ;
    rdfs:label "The Swarm: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "When a beetle latches on a target, it will remain there until it is killed or the duration expires."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5289/note/1> a kg:GameNote ;
    rdfs:label "The Swarm: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Beetles are Spell Immune, but can be killed in %destroy_attacks% attacks from a unit. Heroes deal double damage to beetles."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5289/note/2> a kg:GameNote ;
    rdfs:label "The Swarm: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Beetles provide vision."^^xsd:string ;
    kg:position 2 .

