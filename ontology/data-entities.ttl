<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5481/note/0> a kg:GameNote ;
    rdfs:label "Soul Assumption: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Charges are only gained for damage greater than %damage_min% and less than %damage_max% that is dealt by a player or Roshan.  Self-damage or Soul Assumption damage isn't counted."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5481/note/facet/2> a kg:GameNote ;
    rdfs:label "Soul Assumption: аспект 3"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Soul Assumption kills give %bonus_soul_charge_gold% gold per soul charge, up to %bonus_gold_max_tooltip% gold. Reduced gold from creeps. Enemy heroes killed within %gold_grace_period_hero%s of being affected by Soul Assumption also give gold."^^xsd:string ;
    kg:position 2 .

