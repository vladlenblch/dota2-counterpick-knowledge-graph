<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5496/note/0> a kg:GameNote ;
    rdfs:label "Essence Shift: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Attributes cannot be dropped below 1."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5496/note/1> a kg:GameNote ;
    rdfs:label "Essence Shift: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Essence Shifted stats are returned to normal on death. The stat return for Slark and for the affected hero are separate."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5496/note/2> a kg:GameNote ;
    rdfs:label "Essence Shift: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "To permanently steal Agility, Slark doesn't need to land the killing blow, as long as the enemy hero is killed within Slark's Steal Radius while having the Essence Shift debuff."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5496/note/3> a kg:GameNote ;
    rdfs:label "Essence Shift: примечание 4"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Break disables the gaining of temporary stacks. Does not disable the gaining of permanent stacks."^^xsd:string ;
    kg:position 3 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5496/note/4> a kg:GameNote ;
    rdfs:label "Essence Shift: примечание 5"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Break does not disable the bonuses of existing stacks."^^xsd:string ;
    kg:position 4 .

