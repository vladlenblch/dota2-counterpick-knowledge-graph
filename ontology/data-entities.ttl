<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8235/note/0> a kg:GameNote ;
    rdfs:label "Rebound: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Marci's initial run to her target unit can be disjointed."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8235/note/1> a kg:GameNote ;
    rdfs:label "Rebound: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Does not trigger spell reflect."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8235/note/2> a kg:GameNote ;
    rdfs:label "Rebound: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Does not bring allies who are Rooted or Leashed when alt-cast."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8235/note/facet/3> a kg:GameNote ;
    rdfs:label "Rebound: аспект 4"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText """When Rebound is set to alt-cast, Marci brings the target ally with her to her final destination. The ally deals %ally_impact_damage_pct%%% of the Rebound damage to the enemies around it's destination.

 Will not apply to Rooted or Leashed allies."""^^xsd:string ;
    kg:position 3 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8235/note/facet/4> a kg:GameNote ;
    rdfs:label "Rebound: аспект 5"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText """If Marci has Unleash leveled, after landing from Rebound, Marci gains a %postjump_flurry_charges% strike Fury combo. If Unleash is already active, its duration is instead extended by %postjump_unleash_duration%s.

 If upgraded by Aghanim's Scepter, the resulting Unleashed pulse will not silence enemies."""^^xsd:string ;
    kg:position 4 .

