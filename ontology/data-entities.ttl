<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5348/note/0> a kg:GameNote ;
    rdfs:label "Ice Blast: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Upon cast, this ability is replaced by Release, used to stop the tracer on the target area."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5348/note/1> a kg:GameNote ;
    rdfs:label "Ice Blast: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "The area of effect is %radius_min% + %radius_grow%*TimeTraveled, capped at %radius_max%."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5348/note/2> a kg:GameNote ;
    rdfs:label "Ice Blast: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Kill will be granted to the source of the damage that triggers the shatter."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5348/note/3> a kg:GameNote ;
    rdfs:label "Ice Blast: примечание 4"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "The shatter effect doesn't work on illusions."^^xsd:string ;
    kg:position 3 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5348/note/4> a kg:GameNote ;
    rdfs:label "Ice Blast: примечание 5"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "The HP Freeze prevents most kinds of healing, including the fountain, except Sunder, Time Lapse and Supernova."^^xsd:string ;
    kg:position 4 .

