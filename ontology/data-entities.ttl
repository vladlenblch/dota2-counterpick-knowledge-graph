<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1763> a kg:Ability ;
    rdfs:label "Geomancy"^^xsd:string ;
    kg:behavior "3"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Meepo grants stacking bonuses to himself and his clones based on their terrain. Each Meepo grants his bonus to the other Meepos. If there is a tree within %tree_radius% range, he receives %tree_regen% HP regen. If he is standing on dirt, he receives %dirt_move_speed%%% bonus movement speed. If he is in the water, his attacks slow the target by %water_move_slow%%% for %water_slow_duration% seconds."^^xsd:string ;
    kg:dispellableCode 3 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1763/parameter/cast_point> ;
