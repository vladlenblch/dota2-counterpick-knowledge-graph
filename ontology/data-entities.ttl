<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5527> a kg:Ability ;
    rdfs:label "Chakram"^^xsd:string ;
    kg:behavior "134217776"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Pure"^^xsd:string ;
    kg:damageTypeCode 4 ;
    kg:description "Fires Timbersaw's main saw blade at the target location where it will spin in place, dealing damage in an area around it. Enemies caught in the saw blade will move more slowly for every %slow_health_percentage%%% of health missing. The blade deals damage and cuts down trees in its path when fired and retracted. While active the ability costs mana, and Timbersaw loses the ability to attack."^^xsd:string ;
    kg:dispellableCode 3 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5527/parameter/12> ;
    kg:hasCastRange <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5527/parameter/11>,
