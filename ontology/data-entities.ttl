<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5683> a kg:Ability ;
    rdfs:label "Tempest Double"^^xsd:string ;
    kg:behavior "16"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Briefly refocusing its fractured elements into a single form, the Arc Warden is able to create a perfect electrical duplication of itself. The duplicate can use all of Arc Warden's current items and spells, except most consumables and items that drop on death. The duplicate has separate item and ability cooldowns. The Tempest Double loses its sense of self and fractures over time, becoming slower and less accurate."^^xsd:string ;
    kg:dispellableCode 0 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5683/parameter/12> ;
