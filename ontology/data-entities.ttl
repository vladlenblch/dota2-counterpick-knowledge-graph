<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/995> a kg:Ability ;
    rdfs:label "Uproar"^^xsd:string ;
    kg:behavior "138414084"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "The Beast's temper causes every instance of %damage_limit% hero damage or more to grant a stack of Uproar. When activated, Primal Beast releases a roar that slows surrounding enemies and grants the Beast additional attack damage and armor for %roar_duration% seconds based on his current stacks of Uproar."^^xsd:string ;
