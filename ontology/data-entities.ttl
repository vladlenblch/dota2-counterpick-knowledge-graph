    rdfs:label "Mjollnir: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Static Charge procs will not bounce to heroes that are invisible or hidden by Fog of War."^^xsd:string ;
    kg:position 2 .

