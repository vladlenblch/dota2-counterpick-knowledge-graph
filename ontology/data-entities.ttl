<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5395/note/0> a kg:GameNote ;
    rdfs:label "Summon Wolves: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Using this spell will replace currently active summoned Wolves."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5395/note/facet/1> a kg:GameNote ;
    rdfs:label "Summon Wolves: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Summoned Wolves are invulnerable and uncontrollable spirits that do not attack, but provide health and damage bonuses to Lycan."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5395/note/facet/2> a kg:GameNote ;
    rdfs:label "Summon Wolves: аспект 3"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Max Level increased to %max_level%. Level 5 wolves gain Hamstring, which empowers their attacks to root enemies and cause them to take more physical damage on attacks. Level 6 wolves have Hightail, an active ability that gives wolves phased movement, evasion, movespeed, and attack speed."^^xsd:string ;
    kg:position 2 .

