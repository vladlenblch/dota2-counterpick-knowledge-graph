<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5017/note/0> a kg:GameNote ;
    rdfs:label "Thirst: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Not triggered by Illusions."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5017/note/1> a kg:GameNote ;
    rdfs:label "Thirst: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Max movement speed bonus occurs when an enemy's health is at or below %max_bonus_pct%%%."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5017/note/2> a kg:GameNote ;
    rdfs:label "Thirst: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Effects linger for %linger_duration% seconds if a target dies."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5017/note/facet/1> a kg:GameNote ;
    rdfs:label "Thirst: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Can be activated to grant bonus movement speed and %sanguivore_multiplier%x Sanguivore heal bonus for a short duration. While on cooldown, passive Thirst move speed is reduced by %inactive_penalty_pct%%% . Cannot be cast when all enemy heroes are at full health."^^xsd:string ;
    kg:position 1 .

