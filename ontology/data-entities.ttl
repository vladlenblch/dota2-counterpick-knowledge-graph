<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5610> a kg:Ability ;
    rdfs:label "Geomagnetic Grip"^^xsd:string ;
    kg:behavior "134217752"^^xsd:string ;
