<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5366/note/0> a kg:GameNote ;
    rdfs:label "Unstable Concoction: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "While brewing, this ability is replaced by Unstable Concoction Throw.  Alchemist can move and act normally while brewing."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5366/note/1> a kg:GameNote ;
    rdfs:label "Unstable Concoction: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "A timer above Alchemist's head will indicate the remaining brew time. This timer is visible to enemies."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5366/note/2> a kg:GameNote ;
    rdfs:label "Unstable Concoction: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "You can deny yourself with this skill."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5366/note/3> a kg:GameNote ;
    rdfs:label "Unstable Concoction: примечание 4"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Unstable Concoction cannot be disjointed and once thrown Unstable Concoction stops brewing."^^xsd:string ;
    kg:position 3 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5366/note/4> a kg:GameNote ;
    rdfs:label "Unstable Concoction: примечание 5"^^xsd:string ;
