    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/45> ;
    kg:identifier 5189 ;
    kg:immunityCode 4 ;
    kg:internalName "pugna_life_drain"^^xsd:string ;
    kg:isInnate false ;
    kg:isUltimate true ;
    kg:maxLevel 3 ;
    kg:scepterDescription "Reduces cooldown by %abilitycooldown%s. When targeting an enemy hero, Pugna reduces their outgoing spell damage by %spell_amp_drain_rate%%% per second up to a maximum of %spell_amp_drain_max%%% and increases his own, up to a maximum of %max_spell_amp_drain_pct%%%. When draining through a Nether Ward using Shard, the rate of increase/decrease is %spell_amp_drain_rate_ward%%% instead. Debuff lasts %spell_amp_drain_duration% seconds."^^xsd:string ;
    kg:shardDescription "Life Drain can target your Nether Ward, causing life drain to refract to all enemy heroes within %abilitycastrange% units of the ward for %shard_damage_pct_from_ward%%% of its normal value. The effect is interrupted if the ward is destroyed."^^xsd:string ;
    kg:targetTeam 3 ;
    kg:targetType 19 .

