<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5652> a kg:Ability ;
    rdfs:label "Splinter Blast"^^xsd:string ;
    kg:behavior "40"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Launches a ball of brittle ice toward a unit. The ice shatters on impact, leaving the primary target completely unaffected, while hurling damaging splinters into nearby enemies in a %split_radius% base radius. Enemies struck by these splinters are slowed by %movespeed_slow_tooltip%%%."^^xsd:string ;
    kg:dispellableCode 2 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5652/parameter/10>,
