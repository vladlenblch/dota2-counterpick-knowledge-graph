    rdfs:label "Finger of Death: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Finger of Death only gains damage if the enemy hero dies within %grace_period% seconds of being affected by Finger of Death."^^xsd:string ;
    kg:position 1 .

