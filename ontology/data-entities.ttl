    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "CHANNELED - Primal Beast channels his rage, grabbing the target enemy and slamming them into the ground repeatedly, damaging and mini-stunning any enemies caught in the AoE. Each consecutive hit deals bonus damage. Lasts %channel_time% seconds."^^xsd:string ;
