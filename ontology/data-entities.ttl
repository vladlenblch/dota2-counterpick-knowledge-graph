<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1342> a kg:Ability ;
    rdfs:label "Summon Spirit Bear"^^xsd:string ;
    kg:behavior "4"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Summons a powerful Spirit Bear companion that can equip items. If the bear moves %bear_attack_leash_range% distance away from the Lone Druid, it cannot attack. Lone Druid suffers %backlash_damage%%% of his max health as backlash damage if the Spirit Bear dies. Spirit Bear has Demolish, Return, Entangling Claws, Savage Roar, and Spirit Link abilities."^^xsd:string ;
    kg:dispellableCode 0 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
