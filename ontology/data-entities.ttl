<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5382> a kg:Ability ;
    rdfs:label "Tornado"^^xsd:string ;
    kg:behavior "9007482856800337"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Unleashes a fast moving tornado that picks up enemy units in its path, suspending them helplessly in the air shortly before allowing them to plummet to their doom. Travels further based on the level of Wex . Holds enemies in the air for a duration based on the level of Quas . Deals base damage plus added damage based on levels in Wex . DISPEL TYPE: Basic Dispel"^^xsd:string ;
    kg:dispelType "Basic"^^xsd:string ;
    kg:dispellableCode 2 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5382/parameter/14> ;
    kg:hasCastRange <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5382/parameter/13> ;
    kg:hasCooldown <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5382/parameter/16> ;
    kg:hasDamage <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5382/parameter/10>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5382/parameter/6>,
