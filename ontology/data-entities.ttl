<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5644> a kg:Ability ;
    rdfs:label "Minefield Sign"^^xsd:string ;
    kg:behavior "8589934705"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Plant a warning sign, causing Proximity Mines within its radius to be invulnerable and deal %bonus_mine_damage_pct%%% more damage. Only one sign can exist at a time. Lasts %lifetime% seconds. When an enemy Hero walks within %trigger_radius% units of a minefield sign, the %aura_radius% units area around the sign will become a minefield for %minefield_duration% seconds, dealing damage to enemy Heroes any time they move within its area. Minefield Sign is destroyed after this effect ends."^^xsd:string ;
    kg:dispellableCode 0 ;
    kg:grantedByScepter true ;
    kg:grantedByShard false ;
