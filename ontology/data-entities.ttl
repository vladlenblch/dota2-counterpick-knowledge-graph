<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5194> a kg:Ability ;
    rdfs:label "Refraction"^^xsd:string ;
    kg:behavior "2052"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Physical"^^xsd:string ;
    kg:damageTypeCode 1 ;
    kg:description "Templar Assassin becomes highly elusive, gaining a small barrier and bonus to her damage. The damage and avoidance effects are separate, and have a limited number of instances. If a barrier is consumed, a new one is created as long as there are charges left. If an instance of damage would deal more damage than the remaining barrier, all of the damage is absorbed."^^xsd:string ;
    kg:dispellableCode 3 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5194/parameter/cast_point> ;
    kg:hasCastRange <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5194/parameter/cast_range> ;
