<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5130/note/0> a kg:GameNote ;
    rdfs:label "Shackleshot: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "This spell can shackle two enemies together, stunning them both."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5130/note/1> a kg:GameNote ;
    rdfs:label "Shackleshot: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Can shackle the target to an enemy unit or tree at most %shackle_distance% behind the target."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5130/note/2> a kg:GameNote ;
    rdfs:label "Shackleshot: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Shackleshot can be disjointed."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5130/note/facet/3> a kg:GameNote ;
    rdfs:label "Shackleshot: аспект 4"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Shackleshot applies to all units and trees behind the target unit and grants Windranger bonus attack damage for each additional shackled unit and tree. Creeps and trees grant less bonus damage."^^xsd:string ;
    kg:position 3 .

