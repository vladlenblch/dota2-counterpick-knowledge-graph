<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5188/note/0> a kg:GameNote ;
    rdfs:label "Nether Ward: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Nether Ward deals damage before the actual spell is cast, so if the caster dies the spell will have no effect."^^xsd:string ;
    kg:position 0 .

