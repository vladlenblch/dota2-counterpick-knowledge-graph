<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5322/note/facet/0> a kg:GameNote ;
    rdfs:label "Firefly: аспект 1"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Firefly also lights Batrider on fire. He gains increasingly more Move Speed and burns away a portion of his max health each second. Maximum bonuses are reached at the end of Firefly's duration. Self-burn damage is constant and does not increase over time."^^xsd:string ;
    kg:position 0 .

