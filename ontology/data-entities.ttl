<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5331> a kg:Ability ;
    rdfs:label "Hand of God"^^xsd:string ;
    kg:behavior "4"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Heals all allied heroes on the map as well as all units under Chen's control. A large heal is applied at first and a slow heal over time is applied for %hot_duration% seconds afterwards."^^xsd:string ;
    kg:dispellableCode 2 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5331/parameter/10>,
