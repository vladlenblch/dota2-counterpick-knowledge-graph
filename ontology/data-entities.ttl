<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/321> a kg:Ability ;
    rdfs:label "Overclocking"^^xsd:string ;
    kg:behavior "8589936645"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Supercharges Clockwerks abilities: Battery Assault : Increased radius and affects all enemies in its range. Power Cogs : Radius increased, and Clockwerk's armor while near Power Cogs is increased. Rocket Flares : Increased damage, vision and slow duration, and fire additional rockets to either side of the target. Hookshot : Stun radius and duration increased. Jetpack : Moves faster. Clockwerk's movement and attack speed becomes slowed to a crawl after the duration runs out."^^xsd:string ;
    kg:dispellableCode 3 ;
    kg:grantedByScepter true ;
    kg:grantedByShard false ;
