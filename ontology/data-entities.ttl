    kg:behavior "8"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Enchantress charms an enemy. If the enemy is a hero, they are dispelled and slowed for %slow_duration%s, and Enchantress and her units gain bonus attack range against the target. If the enemy is a creep, she brings it under her control and receives %xp_gain_pct%%% of their experience bounty. Enchantress can control creeps for up to %dominate_duration%s. DISPEL TYPE: Basic Dispel"^^xsd:string ;
