<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5133/note/1> a kg:GameNote ;
    rdfs:label "Focus Fire: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Windranger can move while attacking."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5133/note/facet/2> a kg:GameNote ;
    rdfs:label "Focus Fire: аспект 3"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Focus Fire no longer requires a target, instead firing at random enemies within Windranger's attack range + %bonus_range%. Fires a fixed number of attacks per second, and can only hit the same enemy every 4 shots. Prioritizes Heroes."^^xsd:string ;
    kg:position 2 .

