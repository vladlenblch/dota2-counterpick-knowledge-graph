    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Temporarily alters an ally's destiny, delaying any healing or damage taken until False Promise ends. Any healing that is delayed by False Promise is amplified. Removes most negative status effects and disables on initial cast. DISPEL TYPE: Strong Dispel"^^xsd:string ;
