<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064> a kg:Ability ;
    rdfs:label "Requiem of Souls"^^xsd:string ;
    kg:behavior "67108868"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Shadow Fiend gathers up to %max_soul_release% of his captured souls to release them as lines of demonic energy. Units near Shadow Fiend when the souls are released can be damaged by several lines of energy. Any unit damaged by Requiem of Souls will be feared and have its movement speed and magic resistance reduced for %requiem_slow_duration% seconds for each line hit up to a maximum of %requiem_slow_duration_max%. Lines of energy are created for every soul captured through Necromastery. Requiem of Souls is automatically cast whenever Shadow Fiend dies, regardless of its cooldown."^^xsd:string ;
    kg:dispellableCode 2 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064/parameter/14>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064/parameter/cast_point> ;
    kg:hasCastRange <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064/parameter/cast_range> ;
    kg:hasCooldown <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064/parameter/16> ;
    kg:hasDamage <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064/parameter/13> ;
    kg:hasDuration <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064/parameter/3>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064/parameter/4> ;
    kg:hasManaCost <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064/parameter/15> ;
    kg:hasNote <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064/note/0>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064/note/1> ;
    kg:hasParameter <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064/parameter/0>,
