<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5366> a kg:Ability ;
    rdfs:label "Unstable Concoction"^^xsd:string ;
    kg:behavior "2052"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Physical"^^xsd:string ;
    kg:damageTypeCode 1 ;
    kg:description "Alchemist brews up an unstable concoction that he can throw at an enemy hero, to stun and deal damage in an area around the explosion. The longer the concoction brews, the more damage it deals and the longer the stun. Alchemist is faster while charging the concoction. After %brew_time% seconds, the brew reaches its maximum damage and stun time. However, after %brew_explosion% seconds, the concoction will explode on Alchemist himself if not thrown."^^xsd:string ;
    kg:dispellableCode 1 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5366/parameter/cast_point> ;
