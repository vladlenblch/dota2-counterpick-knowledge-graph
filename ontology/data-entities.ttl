<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5048> a kg:Ability ;
    rdfs:label "Sacred Arrow"^^xsd:string ;
    kg:behavior "134218768"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Fires a long-range arrow with deadly precision, which stuns and damages the first enemy unit it strikes. The stun duration ranges from %arrow_min_stun% to %arrow_max_stun% seconds, with bonus damage up to %arrow_bonus_damage% added, based on the distance the arrow travels to its target. Instantly kills the first non-ancient creep it hits."^^xsd:string ;
    kg:dispellableCode 1 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5048/parameter/15>,
