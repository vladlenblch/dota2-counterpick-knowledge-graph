<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5375/note/0> a kg:GameNote ;
    rdfs:label "Invoke: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "The arrangement of instances does not matter."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5375/note/1> a kg:GameNote ;
    rdfs:label "Invoke: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Invoke will not cost mana or go on cooldown if the only effect is to swap the positions of existing spells."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5375/note/2> a kg:GameNote ;
    rdfs:label "Invoke: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Invoke will not break invisibility and can be cast while channeling."^^xsd:string ;
    kg:position 2 .

