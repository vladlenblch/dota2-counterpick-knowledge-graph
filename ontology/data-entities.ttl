<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7914/note/0> a kg:GameNote ;
    rdfs:label "Celestial Hammer: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "The hammer damages enemies both when thrown and when returning to Dawnbreaker."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7914/note/1> a kg:GameNote ;
    rdfs:label "Celestial Hammer: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Dawnbreaker's Converge movement distance is capped at the ability's cast range."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7914/note/2> a kg:GameNote ;
    rdfs:label "Celestial Hammer: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Starbreaker cannot be cast while the Hammer is out."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7914/note/facet/1> a kg:GameNote ;
    rdfs:label "Celestial Hammer: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "When Celestial Hammer lands on the ground, it creates the healing and damaging effects of Solar Guardian, reduced by %hammer_solar_guardian_effectiveness_pct%%% in a %hammer_solar_guardian_radius% AoE around it. Increases the duration that the hammer can remain stationary to %pause_duration%s."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7914/note/facet/3> a kg:GameNote ;
    rdfs:label "Celestial Hammer: аспект 4"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Allied heroes walking on Celestial Hammer's fire trail gain bonus movement speed."^^xsd:string ;
    kg:position 3 .

