<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5608> a kg:Ability ;
    rdfs:label "Boulder Smash"^^xsd:string ;
    kg:behavior "134217752"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Earth Spirit smashes the target enemy or ally, sending them in the direction he is facing. If Earth Spirit targets an area, he will smash the nearest unit in a %remnant_smash_radius_tooltip% radius, prioritizing Stone Remnants. The travelling unit or Remnant damages all enemy units it hits. If an enemy is hit by a Stone Remnant, they are also slowed. Stone Remnants travel further than other units."^^xsd:string ;
