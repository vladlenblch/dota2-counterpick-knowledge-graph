    kg:isUltimate true ;
    kg:maxLevel 3 ;
    kg:scepterDescription "Increases duration. While Borrowed Time is active, anytime an ally takes more than %ally_threshold_scepter% damage while within Mist Coil's cast range of Abaddon, an individual Mist Coil will automatically fire towards that ally."^^xsd:string ;
    kg:targetTeam 0 ;
