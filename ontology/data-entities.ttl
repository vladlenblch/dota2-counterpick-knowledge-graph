<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5483/note/facet/1> a kg:GameNote ;
    rdfs:label "Summon Familiars: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Familiars will automatically attack the target Visage tried to attack last, and will return if that target is out of Visage's attack range, or Visage issues the cancel current action or hold position commands.<br><br>The ability can be toggled to the Auto-Cast state to command the Familiars to return to Visage and not leave his side until the state has been disabled."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5483/note/facet/2> a kg:GameNote ;
    rdfs:label "Summon Familiars: аспект 3"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "The ability can be cast in the alt-cast state to recall Visages familiars after %recall_duration%s, during which they cannot attack or act."^^xsd:string ;
    kg:position 2 .

