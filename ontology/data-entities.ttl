<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5488> a kg:Ability ;
    rdfs:label "Relocate"^^xsd:string ;
    kg:behavior "16"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Teleports Io and a tethered ally to any location. After the spell expires, Io and the tethered ally will return to their original location. Double-click to teleport to your team's base fountain."^^xsd:string ;
