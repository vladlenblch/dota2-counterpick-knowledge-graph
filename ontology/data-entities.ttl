<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5140/note/0> a kg:GameNote ;
    rdfs:label "Maledict: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "If an affected hero's health has increased above the amount they had when Maledict was cast, the burst damage will be 0."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5140/note/facet/3> a kg:GameNote ;
    rdfs:label "Maledict: аспект 4"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Enemies who die while cursed deal damage equal to %spread_pct%%% of what the next burst damage would be to all enemy units in a %spread_radius% radius."^^xsd:string ;
    kg:position 3 .

