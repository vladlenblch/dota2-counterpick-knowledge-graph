    rdfs:label "Entangle: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Lone Druid's Empowered Buff and enemy stack counter debuff cannot be dispelled."^^xsd:string ;
    kg:position 1 .

