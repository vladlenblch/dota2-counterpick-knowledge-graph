<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7902/note/0> a kg:GameNote ;
    rdfs:label "Starbreaker: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Dawnbreaker travels at a rate of %movement_speed% for the duration of the ability and takes a brief %self_stun_duration%s to recover after the final strike."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7902/note/1> a kg:GameNote ;
    rdfs:label "Starbreaker: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Celestial Hammer or Solar Guardian cannot be cast during the combo."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7902/note/2> a kg:GameNote ;
    rdfs:label "Starbreaker: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Cleave does not work with this ability."^^xsd:string ;
    kg:position 2 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7902/note/3> a kg:GameNote ;
    rdfs:label "Starbreaker: примечание 4"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Can be self-cast to move forward."^^xsd:string ;
    kg:position 3 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7902/note/4> a kg:GameNote ;
    rdfs:label "Starbreaker: примечание 5"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "The first two strikes will slow enemy movement speed by %swipe_slow%%% for %sweep_stun_duration%s."^^xsd:string ;
    kg:position 4 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7902/note/facet/2> a kg:GameNote ;
    rdfs:label "Starbreaker: аспект 3"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Dawnbreaker and her allies in a %movespeed_bonus_radius% radius gain attack speed for %movespeed_bonus_duration% seconds at the end of Starbreaker for each swipe that hit enemy heroes."^^xsd:string ;
    kg:position 2 .

