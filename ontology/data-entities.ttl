    kg:internalName "mars_bulwark"^^xsd:string ;
    kg:isInnate false ;
    kg:isUltimate false ;
    kg:maxLevel 4 ;
    kg:scepterDescription "Creates %soldier_count% invulnerable soldiers on both sides of Mars front while Bulwark is toggled on. Soldiers move alongside Mars, dealing his attacks that have bonus damage, knock back and slow approaching enemies. An enemy can only be attacked by one soldier at a time."^^xsd:string ;
