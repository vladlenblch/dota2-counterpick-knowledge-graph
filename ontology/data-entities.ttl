    kg:hasCooldown <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5427/parameter/7> ;
    kg:hasDuration <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5427/parameter/2> ;
    kg:hasManaCost <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5427/parameter/6> ;
    kg:hasNote <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5427/note/0>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5427/note/facet/1> ;
