<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5047/note/0> a kg:GameNote ;
    rdfs:label "Finger of Death: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Finger of Death has a %damage_delay% delay before the damage is applied after the spell is cast, allowing certain abilities to avoid the damage."^^xsd:string ;
    kg:position 0 .

