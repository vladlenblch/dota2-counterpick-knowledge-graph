    kg:hasNote <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5066/note/0>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5066/note/1>,
