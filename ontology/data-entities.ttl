    kg:internalName "undying_tombstone"^^xsd:string ;
    kg:isInnate false ;
    kg:isUltimate false ;
    kg:maxLevel 4 ;
    kg:shardDescription "Tombstone can be cast on an allied hero to bunker inside of the tombstone. Heroes that enter the Tombstone cannot leave for %tombstone_bunker_cd% seconds nor can they re-enter after leaving. If the tombstone is destroyed with a hero inside, that hero gets stunned for %tombstone_stun_penalty% seconds."^^xsd:string ;
