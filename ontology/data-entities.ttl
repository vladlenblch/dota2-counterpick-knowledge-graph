<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5433/note/facet/0> a kg:GameNote ;
    rdfs:label "Divided We Stand: аспект 1"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Can now be upgraded at level %required_level% and every %bonus_levels_between_upgrades% levels afterwards to a max level of %max_level%. Duplicate Meepos receive %main_meepo_stats_pct%%% of the main Meepo's bonus attributes."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5433/note/facet/1> a kg:GameNote ;
    rdfs:label "Divided We Stand: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "All Meepos have a stackable aura that increases nearby Meepos' attack speed by %support_group_attack_speed_pct%%% and armor by %support_group_armor%. Radius: %support_radius%."^^xsd:string ;
    kg:position 1 .

