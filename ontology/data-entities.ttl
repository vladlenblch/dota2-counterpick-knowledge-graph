<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5482> a kg:Ability ;
    rdfs:label "Gravekeeper's Cloak"^^xsd:string ;
    kg:behavior "2"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Visage generates a layered barrier that protects him from damage. If he receives damage from a player, one layer is removed, and takes time to recover. Visage's Familiars are protected by his cloak when within %radius% range of him, based on the number of layers Visage has."^^xsd:string ;
    kg:dispellableCode 0 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5482/parameter/cast_point> ;
