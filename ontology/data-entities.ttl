<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5464> a kg:Ability ;
    rdfs:label "Spiked Carapace"^^xsd:string ;
    kg:behavior "2052"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "When activated while above ground, Spiked Carapace reflects and negates damage dealt to Nyx Assassin (max once from each source), as well as stunning the source of the damage. Activating Spiked Carapace will not break Vendetta invisibility. While Burrowed, Spiked Carapace instantly stuns nearby enemies when cast."^^xsd:string ;
