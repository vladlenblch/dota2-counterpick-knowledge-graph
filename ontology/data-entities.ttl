<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5067> a kg:Ability ;
    rdfs:label "Juxtapose"^^xsd:string ;
    kg:behavior "2"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Phantom Lancer has a chance to fracture his presence on an attack, creating an illusion of himself. Illusions also have a chance to fracture further. Illusions created from Phantom Lancer last for %illusion_duration% seconds, while illusions created from other illusions last %illusion_from_illusion_duration% seconds."^^xsd:string ;
    kg:dispellableCode 0 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
