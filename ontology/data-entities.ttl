<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8235> a kg:Ability ;
    rdfs:label "Rebound"^^xsd:string ;
    kg:behavior "1074528264"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Marci bounds to the targeted allied unit, choosing a direction and distance she will spring away from it. Upon reaching the unit, Marci lunges to her final destination, damaging and stunning enemies where she lands. When Rebound is set to alt-cast, Marci brings the target ally with her to her final destination. The ally receives %ally_movespeed_pct%%% bonus movement speed for %ally_buff_duration%s."^^xsd:string ;
    kg:dispellableCode 1 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8235/parameter/22> ;
