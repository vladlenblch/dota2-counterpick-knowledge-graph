<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5288> a kg:Ability ;
    rdfs:label "Track"^^xsd:string ;
    kg:behavior "8"^^xsd:string ;
    kg:behaviorFlags 131088 ;
    kg:damageTypeCode 0 ;
    kg:description "Tracks an enemy hero, granting True Sight of the target, increasing the damage they take and providing information on how much gold it is carrying. If the target dies, Bounty Hunter and nearby heroes collect a bonus bounty of gold. Casting Track does not take you out of invisibility."^^xsd:string ;
    kg:dispellableCode 2 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5288/parameter/7>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5288/parameter/cast_point> ;
