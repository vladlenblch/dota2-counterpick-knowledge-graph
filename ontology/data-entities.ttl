<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5048/note/0> a kg:GameNote ;
    rdfs:label "Sacred Arrow: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "For every 150 distance the arrow travels, the stun duration upon impact increases by 0.5 seconds, and the bonus damage added increases by 14."^^xsd:string ;
    kg:position 0 .

