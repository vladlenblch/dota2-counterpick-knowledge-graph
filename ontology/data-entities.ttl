<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5322/note/0> a kg:GameNote ;
    rdfs:label "Firefly: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "During this the Batrider can fly above units, trees and impassable terrain."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5322/note/1> a kg:GameNote ;
    rdfs:label "Firefly: примечание 2"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "If duration ends when above impassable terrain, the Batrider can get stuck."^^xsd:string ;
    kg:position 1 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5322/note/2> a kg:GameNote ;
    rdfs:label "Firefly: примечание 3"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
