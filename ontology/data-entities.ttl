<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/item/164> a kg:Item ;
    rdfs:label "Helm of the Dominator"^^xsd:string ;
    kg:activeEffect "Active: Dominate Takes control of one neutral, non-ancient target unit and sets its movement speed to %speed_base% and max health to a minimum of %health_min%. Also provides the unit with +%creep_bonus_damage% base attack damage, +%creep_bonus_hp_regen% health regen, +%creep_bonus_mp_regen% mana regen and +%creep_bonus_armor% armor. Dominated units with a max health of greater than %health_min% retain their original max health. Grants the caster %bounty_pct%%% of the gold and experience bounty of the dominated creep. Dominated unit's bounty is set to %bounty_gold% gold and it can no longer be killed by abilities that instantly kill creeps otherwise. The Helm cannot be used for %creep_damage_taken_cooldown% seconds after the dominated creep takes damage from an enemy hero or Roshan."^^xsd:string ;
    kg:behavior "33554440"^^xsd:string ;
    kg:behaviorFlags 528 ;
    kg:cost 2550 ;
    kg:damageTypeCode 0 ;
