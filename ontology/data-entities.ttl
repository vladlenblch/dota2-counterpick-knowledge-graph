    rdfs:label "Fiend's Grip"^^xsd:string ;
    kg:behavior "136"^^xsd:string ;
    kg:behaviorFlags 16 ;
    kg:damageType "Pure"^^xsd:string ;
    kg:damageTypeCode 4 ;
    kg:description "CHANNELED - Grips an enemy unit, disabling it and causing heavy damage over time, while stealing mana every %fiend_grip_tick_interval% seconds based on the unit's maximum mana."^^xsd:string ;
