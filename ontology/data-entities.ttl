<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1504> a kg:Ability ;
    rdfs:label "Shodo Sai"^^xsd:string ;
    kg:behavior "9007207987283985"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Kez has a chance to critically strike the target when attacking with Sais. Kez may activate the ability to disarm himself, lock his facing, and parry attacks and attack effects from the targeted direction for %parry_duration% seconds. If an attack is parried from an enemy Hero in this way, that Hero is stunned for %parry_stun_duration%s and gains a Mark. When a Marked target is attacked by Kez, it will guarantee a critical strike and stun the target. The sub-ability may be used to cancel the blocking early."^^xsd:string ;
    kg:dispellableCode 1 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1504/parameter/cast_point> ;
