    rdfs:label "Nightmare"^^xsd:string ;
    kg:behavior "1099545182216"^^xsd:string ;
    kg:behaviorFlags 32 ;
    kg:damageTypeCode 0 ;
    kg:description "Puts the target enemy or friendly Hero to sleep. Sleeping units walk in Bane's chosen direction and are awakened when damaged. If the target was directly attacked, the Nightmare passes to the attacking unit. Bane can attack and damage Nightmared targets freely. Can be put on alt-cast to have the target stand still."^^xsd:string ;
