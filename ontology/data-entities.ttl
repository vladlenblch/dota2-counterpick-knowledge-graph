    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/54> ;
    kg:identifier 5252 ;
    kg:immunityCode 1 ;
    kg:internalName "life_stealer_infest"^^xsd:string ;
    kg:isInnate false ;
    kg:isUltimate true ;
    kg:maxLevel 3 ;
    kg:scepterDescription "Increases cast range and reduces cooldown to %bonus_AbilityCooldown%s. Infest may target enemy heroes for a short duration, attacking them from the inside while increasing Lifestealer's regeneration rate."^^xsd:string ;
    kg:shardDescription "Consuming a creep with Infest drenches enemies in blood which deals damage over time based on the host's remaining health."^^xsd:string ;
    kg:targetTeam 4 ;
