        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5252/parameter/5> ;
    kg:hasManaCost <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5252/parameter/14> ;
    kg:hasNote <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5252/note/0>,
