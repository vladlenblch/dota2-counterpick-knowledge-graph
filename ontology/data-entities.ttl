<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8107> a kg:Ability ;
    rdfs:label "Decoy"^^xsd:string ;
    kg:behavior "8589936709"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageTypeCode 0 ;
    kg:description "Hoodwink turns invisible, increasing her movement speed, and creates a decoy illusion that starts aiming a decreased damage Sharpshooter at the nearest enemy hero. If the illusion is attacked or hit by a targeted ability, it is destroyed and it throws a lesser bushwhack towards the enemy."^^xsd:string ;
