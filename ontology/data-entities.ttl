<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5725> a kg:Ability ;
    rdfs:label "Wukong's Command"^^xsd:string ;
    kg:behavior "67108912"^^xsd:string ;
    kg:behaviorFlags 0 ;
    kg:damageType "Physical"^^xsd:string ;
    kg:damageTypeCode 1 ;
    kg:description "Monkey King creates a circular formation of soldiers that spread out from his position. If Monkey King leaves the area his soldiers disperse. The soldiers have Monkey King's attack that attacks at a fixed rate of %attack_speed%s, and only targets enemy Heroes. Monkey King is granted bonus armor for the spell's duration. Monkey King can transform into any one of his soldiers during Wukong's command, taking its place for a short duration, becoming indistinguishable from other soldiers, and leaving another soldier in his stead."^^xsd:string ;
    kg:dispellableCode 0 ;
    kg:grantedByScepter false ;
    kg:grantedByShard false ;
    kg:hasCastPoint <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5725/parameter/16> ;
    kg:hasCastRange <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5725/parameter/11> ;
