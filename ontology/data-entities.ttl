<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5506/note/0> a kg:GameNote ;
    rdfs:label "Mana Shield: примечание 1"^^xsd:string ;
    kg:noteKind "note"^^xsd:string ;
    kg:noteText "Absorbs damage before any damage reduction takes place, meaning that armor will not reduce the amount of mana needed to absorb damage."^^xsd:string ;
    kg:position 0 .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5506/note/facet/1> a kg:GameNote ;
    rdfs:label "Mana Shield: аспект 2"^^xsd:string ;
    kg:noteKind "facet"^^xsd:string ;
    kg:noteText "Mana Shield can be activated, draining %aspd_increase_mana_cost_pct%%% of max mana per second to gain %aspd_increase_rate_pct%%% attack speed bonus per second, up to %aspd_increase_max_tooltip%%%. Maximum effect reached after %aspd_increase_max_aspd_time%s. Buff lasts %aspd_increase_buff_duration%s and Cooldown is %attack_buff_cooldown%s."^^xsd:string ;
    kg:position 1 .

