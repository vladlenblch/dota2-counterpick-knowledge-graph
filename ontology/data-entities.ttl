    kg:damageType "Magical"^^xsd:string ;
    kg:damageTypeCode 2 ;
    kg:description "Broodmother may create up to %count% invisible web lines touching any existing web. Enemy Heroes that cross the web line will spring the trap, becoming rooted, revealed in fog, and take damage over time. Multiple Heroes can trip on the same line until it's destroyed after being initially triggered. Broodmother's team is alerted via the minimap when an enemy has triggered the snare."^^xsd:string ;
