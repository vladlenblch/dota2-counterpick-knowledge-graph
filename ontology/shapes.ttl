@prefix kg: <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:AbilityShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:identifier ],
        [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:hero ] ;
    sh:targetClass kg:Ability .

kg:CounterRuleShape a sh:NodeShape ;
    sh:property [ sh:class kg:Mechanic ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:sourceMechanic ],
        [ sh:class kg:Mechanic ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:targetMechanic ],
        [ sh:datatype xsd:string ;
            sh:in ( "heuristic"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:ruleStatus ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:evidence ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:ruleWeight ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:ruleFamily ],
        [ sh:datatype xsd:string ;
            sh:in ( "self"^^xsd:string "ally"^^xsd:string "enemy"^^xsd:string "area"^^xsd:string "both"^^xsd:string ) ;
            sh:minCount 0 ;
            sh:path kg:sourceEffectTarget ],
        [ sh:class kg:InteractionCondition ;
            sh:minCount 1 ;
            sh:path kg:requiresCondition ],
        [ sh:class kg:InteractionCondition ;
            sh:minCount 0 ;
            sh:path kg:blockedByCondition ] ;
    sh:targetClass kg:CounterRule .

kg:EffectShape a sh:NodeShape ;
    sh:property [ sh:class kg:Mechanic ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:effectMechanic ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:evidence ],
        [ sh:datatype xsd:string ;
            sh:in ( "feature-derived"^^xsd:string "curated-description"^^xsd:string "structured-description"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:effectStatus ],
        [ sh:class kg:FeatureValue ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:derivedFromFeatureValue ],
        [ sh:class kg:InteractionCondition ;
            sh:minCount 0 ;
            sh:path kg:requiresCondition ],
        [ sh:datatype xsd:string ;
            sh:in ( "Basic"^^xsd:string "Strong"^^xsd:string "None"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:requiredDispel ],
        [ sh:datatype xsd:string ;
            sh:in ( "self"^^xsd:string "ally"^^xsd:string "enemy"^^xsd:string "area"^^xsd:string "both"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:effectTarget ] ;
    sh:targetClass kg:Effect .

kg:FeatureShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:identifier ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:valueKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:unit ] ;
    sh:targetClass kg:Feature .

kg:FeatureValueShape a sh:NodeShape ;
    sh:property [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:hero ],
        [ sh:class kg:Feature ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:feature ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:value ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:isObserved ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:evidence ],
        [ sh:class kg:Ability ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:supportedByAbility ] ;
    sh:targetClass kg:FeatureValue .

kg:GameNoteShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:noteText ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:noteKind ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:position ] ;
    sh:targetClass kg:GameNote .

kg:HeroContextShape a sh:NodeShape ;
    sh:property [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:hero ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:contextComplete ],
        [ sh:class kg:Item ;
            sh:minCount 0 ;
            sh:path kg:heldItem ],
        [ sh:class kg:Talent ;
            sh:minCount 0 ;
            sh:path kg:selectedTalent ] ;
    sh:targetClass kg:HeroContext .

kg:HeroShape a sh:NodeShape ;
    sh:not [ sh:property [ sh:hasValue 1 ;
                    sh:path kg:mostPopularPosition ],
                [ sh:minCount 1 ;
                    sh:path kg:secondMostPopularPosition ] ] ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:identifier ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:carryLevel ],
        [ sh:datatype xsd:integer ;
            sh:disjoint kg:secondMostPopularPosition ;
            sh:maxCount 1 ;
            sh:maxInclusive 5 ;
            sh:minCount 0 ;
            sh:minInclusive 1 ;
            sh:path kg:mostPopularPosition ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 5 ;
            sh:minCount 0 ;
            sh:minInclusive 1 ;
            sh:path kg:secondMostPopularPosition ],
        [ sh:class kg:FeatureValue ;
            sh:minCount 0 ;
            sh:path kg:hasFeatureValue ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:supportLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:nukerLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:disablerLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:junglerLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:durableLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:escapeLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:pusherLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:initiatorLevel ] ;
    sh:targetClass kg:Hero .

kg:HeroStatisticsObservationShape a sh:NodeShape ;
    sh:property [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:hero ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:matches ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:wins ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:winRate ] ;
    sh:targetClass kg:HeroStatisticsObservation .

kg:InteractionConditionShape a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:hasValue "review"^^xsd:string ;
                        sh:path kg:conditionKind ] ] [ sh:property [ sh:hasValue "gameplay"^^xsd:string ;
                        sh:path kg:conditionKind ] ] [ sh:property [ sh:hasValue "has-item"^^xsd:string ;
                        sh:path kg:conditionKind ],
                    [ sh:minCount 1 ;
                        sh:path kg:conditionItem ] ] [ sh:property [ sh:hasValue "has-mechanic"^^xsd:string ;
                        sh:path kg:conditionKind ],
                    [ sh:minCount 1 ;
                        sh:path kg:conditionMechanic ] ] [ sh:property [ sh:hasValue "has-talent"^^xsd:string ;
                        sh:path kg:conditionKind ],
                    [ sh:minCount 1 ;
                        sh:path kg:conditionTalent ] ] ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "review"^^xsd:string "gameplay"^^xsd:string "has-item"^^xsd:string "has-mechanic"^^xsd:string "has-talent"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:conditionKind ],
        [ sh:datatype xsd:string ;
            sh:in ( "source"^^xsd:string "target"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:conditionScope ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:conditionText ],
        [ sh:class kg:Item ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:conditionItem ],
        [ sh:class kg:Mechanic ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:conditionMechanic ],
        [ sh:class kg:Talent ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:conditionTalent ] ;
    sh:targetClass kg:InteractionCondition .

kg:ItemRolePreferenceShape a sh:NodeShape ;
    sh:property [ sh:class kg:Item ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:item ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:roleName ],
        [ sh:datatype xsd:string ;
            sh:in ( "early"^^xsd:string "mid"^^xsd:string "late"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:purchasePhase ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path kg:preferenceRank ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:attackType ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:evidence ] ;
    sh:targetClass kg:ItemRolePreference .

kg:ItemShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:identifier ] ;
    sh:targetClass kg:Item .

kg:ItemUsageObservationShape a sh:NodeShape ;
    sh:property [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:hero ],
        [ sh:class kg:Item ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:item ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:phase ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:usageCount ] ;
    sh:targetClass kg:ItemUsageObservation .

kg:MatchupObservationShape a sh:NodeShape ;
    sh:property [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:hero ],
        [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:opponent ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path kg:matches ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:wins ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:winRate ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 0 ;
            sh:minInclusive -1 ;
            sh:path kg:normalizedAdvantage ] ;
    sh:targetClass kg:MatchupObservation .

kg:MechanicShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:mechanicCategory ] ;
    sh:targetClass kg:Mechanic .

kg:ParameterModifierShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:modifierKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:conditionName ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:operation ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:position ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:Literal ;
            sh:path kg:numericValue ],
        [ sh:class kg:ParameterValue ;
            sh:minCount 0 ;
            sh:path kg:hasBaseValue ] ;
    sh:targetClass kg:ParameterModifier .

kg:ParameterShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:parameterName ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:isPercentage ],
        [ sh:class kg:ParameterValue ;
            sh:minCount 0 ;
            sh:path kg:hasBaseValue ],
        [ sh:class kg:ParameterValue ;
            sh:minCount 0 ;
            sh:path kg:hasShardValue ],
        [ sh:class kg:ParameterValue ;
            sh:minCount 0 ;
            sh:path kg:hasScepterValue ],
        [ sh:class kg:ParameterModifier ;
            sh:minCount 0 ;
            sh:path kg:hasModifier ] ;
    sh:targetClass kg:Parameter .

kg:ParameterValueShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:position ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path kg:numericValue ] ;
    sh:targetClass kg:ParameterValue .

