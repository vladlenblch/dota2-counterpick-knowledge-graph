@prefix kg: <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/ontology#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:AbilityShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:identifier ],
        [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:hero ] ;
    sh:targetClass kg:Ability .

kg:FeatureShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:identifier ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:valueKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:unit ] ;
    sh:targetClass kg:Feature .

kg:FeatureValueShape a sh:NodeShape ;
    sh:property [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:hero ],
        [ sh:class kg:Feature ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:feature ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:value ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:isObserved ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:evidence ],
        [ sh:class kg:Ability ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:supportedByAbility ] ;
    sh:targetClass kg:FeatureValue .

kg:GameNoteShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:noteText ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:noteKind ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:position ] ;
    sh:targetClass kg:GameNote .

kg:HeroShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:identifier ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:carryLevel ],
        [ sh:class kg:FeatureValue ;
            sh:minCount 0 ;
            sh:path kg:hasFeatureValue ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:supportLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:nukerLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:disablerLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:junglerLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:durableLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:escapeLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:pusherLevel ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:initiatorLevel ] ;
    sh:targetClass kg:Hero .

kg:HeroStatisticsObservationShape a sh:NodeShape ;
    sh:property [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:hero ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:matches ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:wins ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:winRate ] ;
    sh:targetClass kg:HeroStatisticsObservation .

kg:ItemShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:identifier ] ;
    sh:targetClass kg:Item .

kg:ItemUsageObservationShape a sh:NodeShape ;
    sh:property [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:hero ],
        [ sh:class kg:Item ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:item ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:phase ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:usageCount ] ;
    sh:targetClass kg:ItemUsageObservation .

kg:MatchupObservationShape a sh:NodeShape ;
    sh:property [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:hero ],
        [ sh:class kg:Hero ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:opponent ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path kg:matches ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:minInclusive 0 ;
            sh:path kg:wins ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:winRate ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 0 ;
            sh:minInclusive -1 ;
            sh:path kg:normalizedAdvantage ] ;
    sh:targetClass kg:MatchupObservation .

kg:ParameterModifierShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:modifierKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:conditionName ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:operation ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:position ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:nodeKind sh:Literal ;
            sh:path kg:numericValue ],
        [ sh:class kg:ParameterValue ;
            sh:minCount 0 ;
            sh:path kg:hasBaseValue ] ;
    sh:targetClass kg:ParameterModifier .

kg:ParameterShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path kg:parameterName ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path kg:isPercentage ],
        [ sh:class kg:ParameterValue ;
            sh:minCount 0 ;
            sh:path kg:hasBaseValue ],
        [ sh:class kg:ParameterValue ;
            sh:minCount 0 ;
            sh:path kg:hasShardValue ],
        [ sh:class kg:ParameterValue ;
            sh:minCount 0 ;
            sh:path kg:hasScepterValue ],
        [ sh:class kg:ParameterModifier ;
            sh:minCount 0 ;
            sh:path kg:hasModifier ] ;
    sh:targetClass kg:Parameter .

kg:ParameterValueShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path kg:position ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path kg:numericValue ] ;
    sh:targetClass kg:ParameterValue .

