@prefix kg: <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/graph/game> a owl:Ontology ;
    rdfs:label "Dota 2: онтология и игровые данные"@ru ;
    owl:imports kg:,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/graph/data-entities>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/graph/data-features>,
        <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/graph/data-statistics> .

