    rdfs:domain kg:Hero ;
    rdfs:range xsd:integer .

kg:supportedByAbility a owl:ObjectProperty ;
    rdfs:label "Способность, объясняющая признак"@ru ;
    rdfs:domain kg:FeatureValue ;
    rdfs:range kg:Ability .

kg:targetTeam a owl:DatatypeProperty ;
    rdfs:label "Код команды цели"@ru ;
    rdfs:range xsd:integer .

kg:targetType a owl:DatatypeProperty ;
    rdfs:label "Код типа цели"@ru ;
    rdfs:range xsd:integer .

kg:turboMatches a owl:DatatypeProperty ;
    rdfs:label "Матчи Turbo"@ru ;
    rdfs:range xsd:integer .

kg:turboWins a owl:DatatypeProperty ;
    rdfs:label "Победы Turbo"@ru ;
    rdfs:range xsd:integer .

kg:turnRate a owl:DatatypeProperty ;
    rdfs:label "Скорость поворота"@ru .

kg:unit a owl:DatatypeProperty ;
    rdfs:label "Единица значения признака"@ru ;
    rdfs:range xsd:string .

kg:usageCount a owl:DatatypeProperty ;
    rdfs:label "Число использований"@ru ;
    rdfs:range xsd:integer .

kg:usedIn a owl:ObjectProperty ;
    rdfs:label "Используется в наблюдении"@ru ;
    rdfs:domain kg:Item ;
    rdfs:range kg:ItemUsageObservation .

kg:value a owl:DatatypeProperty ;
    rdfs:label "Числовое значение"@ru ;
    rdfs:range xsd:double .

kg:valueKind a owl:DatatypeProperty ;
    rdfs:label "Тип значения признака"@ru ;
    rdfs:comment "binary, count или numeric. Бинарная единица означает обнаруженный признак; ноль матрицы не доказывает его отсутствие."@ru ;
    rdfs:domain kg:Feature ;
    rdfs:range xsd:string .

kg:winRate a owl:DatatypeProperty ;
    rdfs:label "Доля побед"@ru ;
    rdfs:range xsd:double .

kg:wins a owl:DatatypeProperty ;
    rdfs:label "Точное число побед"@ru ;
    rdfs:range xsd:integer .

kg:GameNote a owl:Class ;
    rdfs:label "Игровое примечание"@ru ;
    rdfs:comment "Пояснение механики способности, таланта, аспекта или предмета с сохранением вида и порядка примечаний."@ru ;
    rdfs:subClassOf kg:GameFact .

kg:Feature a owl:Class ;
    rdfs:label "Признак"@ru ;
    rdfs:comment "Вид игрового свойства, например оглушение, невидимость или дальность атаки."@ru ;
    rdfs:subClassOf kg:GameCharacteristic .

kg:ParameterModifier a owl:Class ;
    rdfs:label "Модификатор параметра"@ru ;
    rdfs:comment "Условие, операция и изменение параметра от бонуса или аспекта."@ru ;
    rdfs:subClassOf kg:GameFact .

kg:Talent a owl:Class ;
    rdfs:label "Талант"@ru ;
    rdfs:comment "Пассивная способность героя из дерева талантов, изменяющая характеристики или игровые механики."@ru ;
    rdfs:subClassOf kg:Ability .

kg:FeatureValue a owl:Class ;
    rdfs:label "Значение признака героя"@ru ;
    rdfs:comment "Значение признака конкретного героя, его объяснение и связанные способности. isObserved отличает известное значение, включая ноль, от заполнителя матрицы."@ru ;
    rdfs:subClassOf kg:GameFact .

kg:GameCharacteristic a owl:Class ;
    rdfs:label "Игровая характеристика"@ru ;
    rdfs:comment "Вид свойства героя, способности или предмета, для которого задаются значения."@ru .

kg:ItemUsageObservation a owl:Class ;
    rdfs:label "Популярность предмета"@ru ;
    rdfs:comment "Число использований предмета конкретным героем на определённой стадии игры."@ru ;
    rdfs:subClassOf kg:Statistics .

kg:MatchupObservation a owl:Class ;
    rdfs:label "Статистика противостояния"@ru ;
    rdfs:comment "Направленное противостояние двух героев: матчи, победы, доля побед и её отклонение от общей статистики героя."@ru ;
    rdfs:subClassOf kg:Statistics .

kg:ParameterValue a owl:Class ;
    rdfs:label "Значение параметра"@ru ;
    rdfs:comment "Число в последовательности значений параметра. Порядок сохраняется без предположения, что каждая позиция обозначает уровень способности."@ru ;
    rdfs:subClassOf kg:GameFact .

kg:Entity a owl:Class ;
    rdfs:label "Сущность игры"@ru ;
    rdfs:comment "Самостоятельный игровой объект: герой, его способность или предмет."@ru .

kg:Item a owl:Class ;
    rdfs:label "Предмет"@ru ;
    rdfs:comment "Игровой предмет со стоимостью, эффектами, параметрами и статистикой использования."@ru ;
    rdfs:subClassOf kg:Entity .

kg:Statistics a owl:Class ;
    rdfs:label "Игровая статистика"@ru ;
    rdfs:comment "Показатели матчей, противостояний героев и использования предметов."@ru .

kg:Ability a owl:Class ;
    rdfs:label "Способность"@ru ;
    rdfs:comment "Способность героя с описанием механики, параметрами и улучшениями."@ru ;
    rdfs:subClassOf kg:Entity .

kg:GameFact a owl:Class ;
    rdfs:label "Факт об игровой характеристике"@ru ;
    rdfs:comment "Составное утверждение о характеристике: значение, оценка роли, условие изменения или примечание о механике."@ru .

kg:HeroStatisticsObservation a owl:Class ;
    rdfs:label "Общая статистика героя"@ru ;
    rdfs:comment "Число матчей и побед героя, доля побед и показатели профессиональных матчей."@ru ;
    rdfs:subClassOf kg:Statistics .

kg:Hero a owl:Class ;
    rdfs:label "Герой"@ru ;
    rdfs:comment "Игровой герой с характеристиками, способностями, признаками и статистикой."@ru ;
    rdfs:subClassOf kg:Entity .

kg:Parameter a owl:Class ;
    rdfs:label "Параметр способности или предмета"@ru ;
    rdfs:comment "Именованная характеристика способности или предмета: урон, радиус, длительность, бонус или стоимость применения."@ru ;
    rdfs:subClassOf kg:GameCharacteristic .

[] a owl:AllDisjointClasses ;
    owl:members ( kg:Entity kg:GameCharacteristic kg:GameFact kg:Statistics ) .

[] a owl:AllDisjointClasses ;
    owl:members ( kg:Hero kg:Ability kg:Item ) .

