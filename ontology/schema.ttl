@prefix kg: <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg: a owl:Ontology ;
    rdfs:label "Основная онтология Dota 2"@ru ;
    rdfs:comment "Предметная схема героев, способностей, предметов, игровых характеристик и статистики."@ru .

kg:activeEffect a owl:DatatypeProperty ;
    rdfs:label "Активный эффект"@ru ;
    rdfs:range xsd:string .

kg:agility a owl:DatatypeProperty ;
    rdfs:label "Ловкость"@ru ;
    rdfs:range xsd:double .

kg:agilityGain a owl:DatatypeProperty ;
    rdfs:label "Прирост ловкости"@ru ;
    rdfs:range xsd:double .

kg:armor a owl:DatatypeProperty ;
    rdfs:label "Броня"@ru ;
    rdfs:range xsd:double .

kg:attackPoint a owl:DatatypeProperty ;
    rdfs:label "Задержка атаки"@ru .

kg:attackRange a owl:DatatypeProperty ;
    rdfs:label "Дальность атаки"@ru ;
    rdfs:range xsd:double .

kg:attackRate a owl:DatatypeProperty ;
    rdfs:label "Интервал атак"@ru ;
    rdfs:range xsd:double .

kg:attackType a owl:DatatypeProperty ;
    rdfs:label "Тип атаки"@ru ;
    rdfs:range xsd:string .

kg:baseArmor a owl:DatatypeProperty ;
    rdfs:label "Базовая броня"@ru .

kg:baseAttackTime a owl:DatatypeProperty ;
    rdfs:label "Базовое время атаки"@ru ;
    rdfs:range xsd:integer .

kg:baseDamageMax a owl:DatatypeProperty ;
    rdfs:label "Базовый максимальный урон атаки"@ru ;
    rdfs:range xsd:integer .

kg:baseDamageMin a owl:DatatypeProperty ;
    rdfs:label "Базовый минимальный урон атаки"@ru ;
    rdfs:range xsd:integer .

kg:baseHealth a owl:DatatypeProperty ;
    rdfs:label "Базовое здоровье"@ru ;
    rdfs:range xsd:integer .

kg:baseHealthRegen a owl:DatatypeProperty ;
    rdfs:label "Базовое восстановление здоровья"@ru .

kg:baseMana a owl:DatatypeProperty ;
    rdfs:label "Базовая мана"@ru ;
    rdfs:range xsd:integer .

kg:baseManaRegen a owl:DatatypeProperty ;
    rdfs:label "Базовое восстановление маны"@ru .

kg:baselineStatistics a owl:ObjectProperty ;
    rdfs:label "Агрегат для базовой доли побед"@ru ;
    rdfs:domain kg:MatchupObservation ;
    rdfs:range kg:HeroStatisticsObservation .

kg:behavior a owl:DatatypeProperty ;
    rdfs:label "Код поведения"@ru ;
    rdfs:range xsd:string .

kg:behaviorFlags a owl:DatatypeProperty ;
    rdfs:label "Флаги игровой механики"@ru ;
    rdfs:range xsd:integer .

kg:captainsModeEnabled a owl:DatatypeProperty ;
    rdfs:label "Доступен в Captains Mode"@ru ;
    rdfs:range xsd:boolean .

kg:carryLevel a owl:DatatypeProperty ;
    rdfs:label "Выраженность роли керри"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range xsd:integer .

kg:complexity a owl:DatatypeProperty ;
    rdfs:label "Сложность"@ru ;
    rdfs:range xsd:integer .

kg:conditionName a owl:DatatypeProperty ;
    rdfs:label "Название условия модификации"@ru ;
    rdfs:range xsd:string .

kg:cost a owl:DatatypeProperty ;
    rdfs:label "Стоимость"@ru ;
    rdfs:range xsd:integer .

kg:damageMax a owl:DatatypeProperty ;
    rdfs:label "Максимальный урон атаки"@ru ;
    rdfs:range xsd:double .

kg:damageMin a owl:DatatypeProperty ;
    rdfs:label "Минимальный урон атаки"@ru ;
    rdfs:range xsd:double .

kg:damageType a owl:DatatypeProperty ;
    rdfs:label "Тип урона"@ru ;
    rdfs:range xsd:string .

kg:damageTypeCode a owl:DatatypeProperty ;
    rdfs:label "Код типа урона"@ru ;
    rdfs:range xsd:integer .

kg:dayVision a owl:DatatypeProperty ;
    rdfs:label "Дальность обзора днем"@ru ;
    rdfs:range xsd:integer .

kg:description a owl:DatatypeProperty ;
    rdfs:label "Описание"@ru ;
    rdfs:range xsd:string .

kg:disablerLevel a owl:DatatypeProperty ;
    rdfs:label "Выраженность роли контроля"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range xsd:integer .

kg:dispelType a owl:DatatypeProperty ;
    rdfs:label "Тип развеивания"@ru ;
    rdfs:range xsd:string .

kg:dispellableCode a owl:DatatypeProperty ;
    rdfs:label "Код снимаемости эффектов"@ru ;
    rdfs:range xsd:integer .

kg:durableLevel a owl:DatatypeProperty ;
    rdfs:label "Выраженность роли стойкости"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range xsd:integer .

kg:escapeLevel a owl:DatatypeProperty ;
    rdfs:label "Выраженность роли побега"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range xsd:integer .

kg:evidence a owl:DatatypeProperty ;
    rdfs:label "Объяснение игрового признака"@ru ;
    rdfs:range xsd:string .

kg:feature a owl:ObjectProperty ;
    rdfs:label "Тип признака"@ru ;
    rdfs:range kg:Feature .

kg:gameplayDescription a owl:DatatypeProperty ;
    rdfs:label "Описание стиля игры"@ru ;
    rdfs:range xsd:string .

kg:grantedByScepter a owl:DatatypeProperty ;
    rdfs:label "Предоставляется Scepter"@ru ;
    rdfs:range xsd:boolean .

kg:grantedByShard a owl:DatatypeProperty ;
    rdfs:label "Предоставляется Shard"@ru ;
    rdfs:range xsd:boolean .

kg:hasAbility a owl:ObjectProperty ;
    rdfs:label "Способность героя"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range kg:Ability .

kg:hasBaseValue a owl:ObjectProperty ;
    rdfs:label "Базовое значение"@ru ;
    rdfs:range kg:ParameterValue .

kg:hasBonusParameter a owl:ObjectProperty ;
    rdfs:label "Параметр бонуса предмета"@ru ;
    rdfs:domain kg:Item ;
    rdfs:range kg:Parameter .

kg:hasCastPoint a owl:ObjectProperty ;
    rdfs:label "Параметр задержки применения"@ru ;
    rdfs:range kg:Parameter .

kg:hasCastRange a owl:ObjectProperty ;
    rdfs:label "Параметр дальности применения"@ru ;
    rdfs:range kg:Parameter .

kg:hasChannelTime a owl:ObjectProperty ;
    rdfs:label "Параметр времени поддержания"@ru ;
    rdfs:range kg:Parameter .

kg:hasCooldown a owl:ObjectProperty ;
    rdfs:label "Параметр перезарядки"@ru ;
    rdfs:range kg:Parameter .

kg:hasDamage a owl:ObjectProperty ;
    rdfs:label "Параметр урона"@ru ;
    rdfs:comment "Именованные компоненты урона, включая периодический урон и коэффициенты. Единицы и условия сохраняются в параметрах; компоненты не складываются в общий урон. Нулевое общее поле API не означает отсутствие урона."@ru ;
    rdfs:range kg:Parameter .

kg:hasDuration a owl:ObjectProperty ;
    rdfs:label "Параметр длительности"@ru ;
    rdfs:comment "Длительности отдельных эффектов способности или предмета. Подъем, оглушение, падение и другие эффекты сохраняются раздельно."@ru ;
    rdfs:range kg:Parameter .

kg:hasFeatureValue a owl:ObjectProperty ;
    rdfs:label "Значение признака героя"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range kg:FeatureValue .

kg:hasHealthCost a owl:ObjectProperty ;
    rdfs:label "Параметр расхода здоровья"@ru ;
    rdfs:comment "Параметры разового или постоянного расхода здоровья с сохранением исходных значений и условий."@ru ;
    rdfs:range kg:Parameter .

kg:hasItemUsage a owl:ObjectProperty ;
    rdfs:label "Использование предмета героем"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range kg:ItemUsageObservation .

kg:hasManaCost a owl:ObjectProperty ;
    rdfs:label "Параметр расхода маны"@ru ;
    rdfs:comment "Параметры разового или постоянного расхода маны. Условия и способ расходования, включая расход в секунду, сохраняются в именованных параметрах."@ru ;
    rdfs:range kg:Parameter .

kg:hasMatchup a owl:ObjectProperty ;
    rdfs:label "Матчап героя"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range kg:MatchupObservation .

kg:hasModifier a owl:ObjectProperty ;
    rdfs:label "Модификатор"@ru ;
    rdfs:domain kg:Parameter ;
    rdfs:range kg:ParameterModifier .

kg:hasNote a owl:ObjectProperty ;
    rdfs:label "Игровое примечание"@ru ;
    rdfs:range kg:GameNote .

kg:hasParameter a owl:ObjectProperty ;
    rdfs:label "Именованный параметр"@ru ;
    rdfs:range kg:Parameter .

kg:hasPublicMatchTrend a owl:ObjectProperty ;
    rdfs:label "Динамика числа публичных матчей"@ru ;
    rdfs:domain kg:HeroStatisticsObservation ;
    rdfs:range kg:Parameter .

kg:hasPublicWinTrend a owl:ObjectProperty ;
    rdfs:label "Динамика публичных побед"@ru ;
    rdfs:domain kg:HeroStatisticsObservation ;
    rdfs:range kg:Parameter .

kg:hasRadiusParameter a owl:ObjectProperty ;
    rdfs:label "Параметр радиуса"@ru ;
    rdfs:domain kg:Ability ;
    rdfs:range kg:Parameter .

kg:hasScepterUpgrade a owl:DatatypeProperty ;
    rdfs:label "Есть улучшение Scepter"@ru ;
    rdfs:range xsd:boolean .

kg:hasScepterValue a owl:ObjectProperty ;
    rdfs:label "Изменение Scepter"@ru ;
    rdfs:domain kg:Parameter ;
    rdfs:range kg:ParameterValue .

kg:hasShardUpgrade a owl:DatatypeProperty ;
    rdfs:label "Есть улучшение Shard"@ru ;
    rdfs:range xsd:boolean .

kg:hasShardValue a owl:ObjectProperty ;
    rdfs:label "Изменение Shard"@ru ;
    rdfs:domain kg:Parameter ;
    rdfs:range kg:ParameterValue .

kg:hasStatistics a owl:ObjectProperty ;
    rdfs:label "Статистика героя"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range kg:HeroStatisticsObservation .

kg:hasTalent a owl:ObjectProperty ;
    rdfs:label "Талант героя"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range kg:Talent .

kg:hasTurboMatchTrend a owl:ObjectProperty ;
    rdfs:label "Динамика числа матчей Turbo"@ru ;
    rdfs:domain kg:HeroStatisticsObservation ;
    rdfs:range kg:Parameter .

kg:hasTurboWinTrend a owl:ObjectProperty ;
    rdfs:label "Динамика побед Turbo"@ru ;
    rdfs:domain kg:HeroStatisticsObservation ;
    rdfs:range kg:Parameter .

kg:health a owl:DatatypeProperty ;
    rdfs:label "Здоровье"@ru ;
    rdfs:range xsd:double .

kg:healthRegen a owl:DatatypeProperty ;
    rdfs:label "Восстановление здоровья"@ru ;
    rdfs:range xsd:double .

kg:hero a owl:ObjectProperty ;
    rdfs:label "Герой"@ru ;
    rdfs:range kg:Hero .

kg:identifier a owl:DatatypeProperty ;
    rdfs:label "Игровой идентификатор"@ru .

kg:immunityCode a owl:DatatypeProperty ;
    rdfs:label "Код взаимодействия с невосприимчивостью"@ru ;
    rdfs:range xsd:integer .

kg:initialCharges a owl:DatatypeProperty ;
    rdfs:label "Начальное число зарядов"@ru ;
    rdfs:range xsd:integer .

kg:initiatorLevel a owl:DatatypeProperty ;
    rdfs:label "Выраженность роли инициации"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range xsd:integer .

kg:intelligence a owl:DatatypeProperty ;
    rdfs:label "Интеллект"@ru ;
    rdfs:range xsd:double .

kg:intelligenceGain a owl:DatatypeProperty ;
    rdfs:label "Прирост интеллекта"@ru ;
    rdfs:range xsd:double .

kg:internalName a owl:DatatypeProperty ;
    rdfs:label "Внутреннее имя"@ru ;
    rdfs:range xsd:string .

kg:isInnate a owl:DatatypeProperty ;
    rdfs:label "Врождённая способность"@ru ;
    rdfs:range xsd:boolean .

kg:isNeutral a owl:DatatypeProperty ;
    rdfs:label "Нейтральный предмет"@ru ;
    rdfs:range xsd:boolean .

kg:isObserved a owl:DatatypeProperty ;
    rdfs:label "Значение задано"@ru ;
    rdfs:comment "true означает известное значение признака; false означает заполнитель матрицы, а не отсутствие игровой механики."@ru ;
    rdfs:domain kg:FeatureValue ;
    rdfs:range xsd:boolean .

kg:isPercentage a owl:DatatypeProperty ;
    rdfs:label "Значение в процентах"@ru ;
    rdfs:range xsd:boolean .

kg:isPurchasable a owl:DatatypeProperty ;
    rdfs:label "Можно купить"@ru ;
    rdfs:range xsd:boolean .

kg:isUltimate a owl:DatatypeProperty ;
    rdfs:label "Ультимативная способность"@ru ;
    rdfs:range xsd:boolean .

kg:item a owl:ObjectProperty ;
    rdfs:label "Предмет"@ru ;
    rdfs:range kg:Item .

kg:junglerLevel a owl:DatatypeProperty ;
    rdfs:label "Выраженность роли лесника"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range xsd:integer .

kg:magicResistance a owl:DatatypeProperty ;
    rdfs:label "Сопротивление магии"@ru ;
    rdfs:range xsd:double .

kg:mana a owl:DatatypeProperty ;
    rdfs:label "Мана"@ru ;
    rdfs:range xsd:double .

kg:manaRegen a owl:DatatypeProperty ;
    rdfs:label "Восстановление маны"@ru ;
    rdfs:range xsd:double .

kg:matches a owl:DatatypeProperty ;
    rdfs:label "Число матчей"@ru ;
    rdfs:range xsd:integer .

kg:maxLevel a owl:DatatypeProperty ;
    rdfs:label "Максимальное число уровней"@ru ;
    rdfs:range xsd:integer .

kg:modifierKind a owl:DatatypeProperty ;
    rdfs:label "Тип модификатора"@ru ;
    rdfs:range xsd:string .

kg:movementSpeed a owl:DatatypeProperty ;
    rdfs:label "Скорость передвижения"@ru ;
    rdfs:range xsd:double .

kg:neutralTier a owl:DatatypeProperty ;
    rdfs:label "Уровень нейтрального предмета"@ru ;
    rdfs:range xsd:integer .

kg:nightVision a owl:DatatypeProperty ;
    rdfs:label "Дальность обзора ночью"@ru ;
    rdfs:range xsd:integer .

kg:normalizedAdvantage a owl:DatatypeProperty ;
    rdfs:label "Отклонение от базовой доли побед"@ru ;
    rdfs:comment "winRate этого матчапа минус winRate общей статистики ТОГО ЖЕ героя. Это описательная оценка по агрегатам, не причинная сила контрпика."@ru ;
    rdfs:range xsd:double .

kg:noteKind a owl:DatatypeProperty ;
    rdfs:label "Вид игрового примечания"@ru ;
    rdfs:range xsd:string .

kg:noteText a owl:DatatypeProperty ;
    rdfs:label "Текст примечания"@ru ;
    rdfs:range xsd:string .

kg:nukerLevel a owl:DatatypeProperty ;
    rdfs:label "Выраженность роли быстрого урона"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range xsd:integer .

kg:numericValue a owl:DatatypeProperty ;
    rdfs:label "Числовое значение параметра"@ru .

kg:operation a owl:DatatypeProperty ;
    rdfs:label "Код операции изменения параметра"@ru ;
    rdfs:range xsd:integer .

kg:opponent a owl:ObjectProperty ;
    rdfs:label "Противник"@ru ;
    rdfs:domain kg:MatchupObservation ;
    rdfs:range kg:Hero .

kg:parameterHeading a owl:DatatypeProperty ;
    rdfs:label "Заголовок параметра"@ru ;
    rdfs:range xsd:string .

kg:parameterName a owl:DatatypeProperty ;
    rdfs:label "Название игрового параметра"@ru ;
    rdfs:range xsd:string .

kg:passiveEffect a owl:DatatypeProperty ;
    rdfs:label "Пассивный эффект"@ru ;
    rdfs:range xsd:string .

kg:phase a owl:DatatypeProperty ;
    rdfs:label "Стадия игры"@ru ;
    rdfs:domain kg:ItemUsageObservation ;
    rdfs:range xsd:string .

kg:piercesDebuffImmunity a owl:DatatypeProperty ;
    rdfs:label "Проходит сквозь невосприимчивость к эффектам"@ru ;
    rdfs:range xsd:boolean .

kg:position a owl:DatatypeProperty ;
    rdfs:label "Позиция значения, примечания или модификатора"@ru ;
    rdfs:range xsd:integer .

kg:primaryAttribute a owl:DatatypeProperty ;
    rdfs:label "Основная характеристика"@ru ;
    rdfs:range xsd:string .

kg:professionalBans a owl:DatatypeProperty ;
    rdfs:label "Запреты в профессиональных матчах"@ru ;
    rdfs:range xsd:integer .

kg:professionalMatches a owl:DatatypeProperty ;
    rdfs:label "Профессиональные матчи"@ru ;
    rdfs:range xsd:integer .

kg:professionalWins a owl:DatatypeProperty ;
    rdfs:label "Победы в профессиональных матчах"@ru ;
    rdfs:range xsd:integer .

kg:projectileSpeed a owl:DatatypeProperty ;
    rdfs:label "Скорость снаряда"@ru ;
    rdfs:range xsd:integer .

kg:publicMatches a owl:DatatypeProperty ;
    rdfs:label "Публичные матчи"@ru ;
    rdfs:range xsd:integer .

kg:publicWins a owl:DatatypeProperty ;
    rdfs:label "Публичные победы"@ru ;
    rdfs:range xsd:integer .

kg:pusherLevel a owl:DatatypeProperty ;
    rdfs:label "Выраженность роли осады"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range xsd:integer .

kg:qualityCode a owl:DatatypeProperty ;
    rdfs:label "Код категории предмета"@ru ;
    rdfs:range xsd:integer .

kg:requiredFacet a owl:DatatypeProperty ;
    rdfs:label "Необходимый аспект"@ru ;
    rdfs:range xsd:string .

kg:requiresTalent a owl:ObjectProperty ;
    rdfs:label "Требует талант"@ru ;
    rdfs:domain kg:ParameterModifier ;
    rdfs:range kg:Talent .

kg:roleName a owl:DatatypeProperty ;
    rdfs:label "Название игровой роли"@ru ;
    rdfs:range xsd:string .

kg:roleSummary a owl:DatatypeProperty ;
    rdfs:label "Краткая игровая характеристика"@ru ;
    rdfs:range xsd:string .

kg:scepterDescription a owl:DatatypeProperty ;
    rdfs:label "Описание улучшения Scepter"@ru ;
    rdfs:range xsd:string .

kg:shardDescription a owl:DatatypeProperty ;
    rdfs:label "Описание улучшения Shard"@ru ;
    rdfs:range xsd:string .

kg:stockLimit a owl:DatatypeProperty ;
    rdfs:label "Максимальный запас в магазине"@ru ;
    rdfs:range xsd:integer .

kg:stockReplenishTime a owl:DatatypeProperty ;
    rdfs:label "Время восстановления запаса магазина"@ru ;
    rdfs:range xsd:integer .

kg:strength a owl:DatatypeProperty ;
    rdfs:label "Сила"@ru ;
    rdfs:range xsd:double .

kg:strengthGain a owl:DatatypeProperty ;
    rdfs:label "Прирост силы"@ru ;
    rdfs:range xsd:double .

kg:supportLevel a owl:DatatypeProperty ;
