@prefix kg: <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

prov:wasDerivedFrom a owl:ObjectProperty .

kg: a owl:Ontology ;
    rdfs:label "Основная онтология Dota 2"@ru ;
    rdfs:comment "Предметная схема героев, способностей, предметов и наблюдений исходного снимка. Полный архив исходников подключается через dota2.ttl."@ru .

kg:ItemSnapshot a owl:Class ;
    rdfs:label "Снимок предмета"@ru ;
    rdfs:comment "Характеристики предмета в исходном снимке Valve."@ru ;
    rdfs:subClassOf kg:Observation .

kg:ability a owl:ObjectProperty ;
    rdfs:label "Способность"@ru ;
    rdfs:domain kg:AbilitySnapshot ;
    rdfs:range kg:Ability .

kg:abilityId a owl:DatatypeProperty ;
    rdfs:label "Идентификатор способности"@ru ;
    rdfs:range xsd:integer .

kg:activeEffect a owl:DatatypeProperty ;
    rdfs:label "Активный эффект"@ru ;
    rdfs:range xsd:string .

kg:agility a owl:DatatypeProperty ;
    rdfs:label "Ловкость"@ru ;
    rdfs:range xsd:double .

kg:agilityGain a owl:DatatypeProperty ;
    rdfs:label "Прирост ловкости"@ru ;
    rdfs:range xsd:double .

kg:armor a owl:DatatypeProperty ;
    rdfs:label "Броня"@ru ;
    rdfs:range xsd:double .

kg:attackRange a owl:DatatypeProperty ;
    rdfs:label "Дальность атаки"@ru ;
    rdfs:range xsd:double .

kg:attackRate a owl:DatatypeProperty ;
    rdfs:label "Интервал атак"@ru ;
    rdfs:range xsd:double .

kg:attackType a owl:DatatypeProperty ;
    rdfs:label "Тип атаки"@ru ;
    rdfs:range xsd:string .

kg:baseValues a owl:ObjectProperty ;
    rdfs:label "Исходный массив значений"@ru ;
    rdfs:domain kg:Parameter ;
    rdfs:range kg:JsonValue .

kg:baselineStatistics a owl:ObjectProperty ;
    rdfs:label "Агрегат для базовой доли побед"@ru ;
    rdfs:domain kg:MatchupObservation ;
    rdfs:range kg:HeroStatisticsObservation .

kg:behavior a owl:DatatypeProperty ;
    rdfs:label "Код поведения"@ru ;
    rdfs:range xsd:string .

kg:bonusesValues a owl:ObjectProperty ;
    rdfs:label "Бонусы предмета"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:byteLength a owl:DatatypeProperty ;
    rdfs:label "Число исходных байтов"@ru ;
    rdfs:range xsd:integer .

kg:castPointValues a owl:ObjectProperty ;
    rdfs:label "Задержка применения по уровням"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:castRangeValues a owl:ObjectProperty ;
    rdfs:label "Дальность применения по уровням"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:collectedAt a owl:DatatypeProperty ;
    rdfs:label "Время получения API"@ru ;
    rdfs:comment "Время сбора ответа API. Не является датой матчей или идентификатором патча."@ru ;
    rdfs:range xsd:dateTime .

kg:complexity a owl:DatatypeProperty ;
    rdfs:label "Сложность"@ru ;
    rdfs:range xsd:integer .

kg:cooldownValues a owl:ObjectProperty ;
    rdfs:label "Перезарядка по уровням"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:cost a owl:DatatypeProperty ;
    rdfs:label "Стоимость"@ru ;
    rdfs:range xsd:integer .

kg:damageMax a owl:DatatypeProperty ;
    rdfs:label "Максимальный урон атаки"@ru ;
    rdfs:range xsd:double .

kg:damageMin a owl:DatatypeProperty ;
    rdfs:label "Минимальный урон атаки"@ru ;
    rdfs:range xsd:double .

kg:damageType a owl:DatatypeProperty ;
    rdfs:label "Тип урона"@ru ;
    rdfs:range xsd:string .

kg:damageTypeCode a owl:DatatypeProperty ;
    rdfs:label "Код типа урона"@ru ;
    rdfs:range xsd:integer .

kg:damageValues a owl:ObjectProperty ;
    rdfs:label "Урон по уровням"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:description a owl:DatatypeProperty ;
    rdfs:label "Описание"@ru ;
    rdfs:range xsd:string .

kg:dispelType a owl:DatatypeProperty ;
    rdfs:label "Тип развеивания"@ru ;
    rdfs:range xsd:string .

kg:dispellableCode a owl:DatatypeProperty ;
    rdfs:label "Код снимаемости эффектов"@ru ;
    rdfs:range xsd:integer .

kg:displayName a owl:DatatypeProperty ;
    rdfs:label "Название"@ru ;
    rdfs:range xsd:string .

kg:durationValues a owl:ObjectProperty ;
    rdfs:label "Длительность по уровням"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:entryCount a owl:DatatypeProperty ;
    rdfs:label "Число элементов JSON"@ru ;
    rdfs:range xsd:integer .

kg:entryIndex a owl:DatatypeProperty ;
    rdfs:label "Индекс массива с 0"@ru ;
    rdfs:range xsd:integer .

kg:entryKey a owl:DatatypeProperty ;
    rdfs:label "Ключ объекта JSON"@ru ;
    rdfs:range xsd:string .

kg:evidence a owl:DatatypeProperty ;
    rdfs:label "Исходное доказательство"@ru ;
    rdfs:range xsd:string .

kg:facetsValues a owl:ObjectProperty ;
    rdfs:label "Аспекты героя"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:feature a owl:ObjectProperty ;
    rdfs:label "Тип признака"@ru ;
    rdfs:range kg:Feature .

kg:featureCode a owl:DatatypeProperty ;
    rdfs:label "Код признака"@ru ;
    rdfs:range xsd:string .

kg:hasAbilitySnapshot a owl:ObjectProperty ;
    rdfs:label "Снимок способности героя"@ru ;
    rdfs:domain kg:HeroSnapshot ;
    rdfs:range kg:AbilitySnapshot .

kg:hasArtifact a owl:ObjectProperty ;
    rdfs:label "Исходный файл снимка"@ru ;
    rdfs:domain kg:DatasetSnapshot ;
    rdfs:range kg:SourceArtifact .

kg:hasEntry a owl:ObjectProperty ;
    rdfs:label "Элемент JSON"@ru ;
    rdfs:domain kg:JsonValue ;
    rdfs:range kg:JsonEntry .

kg:hasFeatureObservation a owl:ObjectProperty ;
    rdfs:label "Наблюдение признака"@ru ;
    rdfs:domain kg:Hero ;
    rdfs:range kg:FeatureObservation .

kg:hasParameter a owl:ObjectProperty ;
    rdfs:label "Именованный параметр"@ru ;
    rdfs:range kg:Parameter .

kg:hasRankObservation a owl:ObjectProperty ;
    rdfs:label "Статистика по интервалу"@ru ;
    rdfs:domain kg:HeroStatisticsObservation ;
    rdfs:range kg:RankBracketObservation .

kg:hasRecord a owl:ObjectProperty ;
    rdfs:label "Запись об игровой сущности"@ru ;
    rdfs:domain kg:Entity ;
    rdfs:range kg:Observation .

kg:health a owl:DatatypeProperty ;
    rdfs:label "Здоровье"@ru ;
    rdfs:range xsd:double .

kg:healthCostValues a owl:ObjectProperty ;
    rdfs:label "Затраты здоровья по уровням"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:healthRegen a owl:DatatypeProperty ;
    rdfs:label "Восстановление здоровья"@ru ;
    rdfs:range xsd:double .

kg:hero a owl:ObjectProperty ;
    rdfs:label "Герой наблюдения"@ru ;
    rdfs:range kg:Hero .

kg:heroId a owl:DatatypeProperty ;
    rdfs:label "Идентификатор героя"@ru ;
    rdfs:range xsd:integer .

kg:identifier a owl:DatatypeProperty ;
    rdfs:label "Исходный идентификатор"@ru .

kg:immunityCode a owl:DatatypeProperty ;
    rdfs:label "Код взаимодействия с невосприимчивостью"@ru ;
    rdfs:range xsd:integer .

kg:intelligence a owl:DatatypeProperty ;
    rdfs:label "Интеллект"@ru ;
    rdfs:range xsd:double .

kg:intelligenceGain a owl:DatatypeProperty ;
    rdfs:label "Прирост интеллекта"@ru ;
    rdfs:range xsd:double .

kg:internalName a owl:DatatypeProperty ;
    rdfs:label "Внутреннее имя"@ru ;
    rdfs:range xsd:string .

kg:isInnate a owl:DatatypeProperty ;
    rdfs:label "Врождённая способность"@ru ;
    rdfs:range xsd:boolean .

kg:isNeutral a owl:DatatypeProperty ;
    rdfs:label "Нейтральный предмет"@ru ;
    rdfs:range xsd:boolean .

kg:isPurchasable a owl:DatatypeProperty ;
    rdfs:label "Можно купить"@ru ;
    rdfs:range xsd:boolean .

kg:isUltimate a owl:DatatypeProperty ;
    rdfs:label "Ультимативная способность"@ru ;
    rdfs:range xsd:boolean .

kg:item a owl:ObjectProperty ;
    rdfs:label "Предмет"@ru ;
    rdfs:range kg:Item .

kg:itemId a owl:DatatypeProperty ;
    rdfs:label "Идентификатор предмета"@ru ;
    rdfs:range xsd:integer .

kg:jsonChild a owl:ObjectProperty ;
    rdfs:label "Вложенное значение JSON"@ru ;
    rdfs:domain kg:JsonEntry ;
    rdfs:range kg:JsonValue .

kg:jsonKind a owl:DatatypeProperty ;
    rdfs:label "Тип значения JSON"@ru ;
    rdfs:comment "object, array, scalar или null. Тип различает пустые контейнеры, null и скалярные значения."@ru ;
    rdfs:domain kg:JsonValue ;
    rdfs:range xsd:string .

kg:jsonRoot a owl:ObjectProperty ;
    rdfs:label "Корень структуры JSON"@ru ;
    rdfs:range kg:JsonValue .

kg:jsonScalar a owl:DatatypeProperty ;
    rdfs:label "Скалярное значение JSON"@ru .

kg:magicResistance a owl:DatatypeProperty ;
    rdfs:label "Сопротивление магии"@ru ;
    rdfs:range xsd:double .

kg:mana a owl:DatatypeProperty ;
    rdfs:label "Мана"@ru ;
    rdfs:range xsd:double .

kg:manaCostValues a owl:ObjectProperty ;
    rdfs:label "Затраты маны по уровням"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:manaRegen a owl:DatatypeProperty ;
    rdfs:label "Восстановление маны"@ru ;
    rdfs:range xsd:double .

kg:matches a owl:DatatypeProperty ;
    rdfs:label "Число матчей"@ru ;
    rdfs:range xsd:integer .

kg:matrixFeatureOrder a owl:ObjectProperty ;
    rdfs:label "Порядок признаков матрицы"@ru ;
    rdfs:comment "Упорядоченный массив исходных имён колонок признаков; индексы совпадают с matrixValues."@ru ;
    rdfs:domain kg:DatasetSnapshot ;
    rdfs:range kg:JsonValue .

kg:matrixValues a owl:ObjectProperty ;
    rdfs:label "Значения вектора признаков"@ru ;
    rdfs:comment "Упорядоченный массив всех числовых значений, включая нули. Порядок признаков задан matrixFeatureOrder снимка."@ru ;
    rdfs:domain kg:FeatureVector ;
    rdfs:range kg:JsonValue .

kg:mediaType a owl:DatatypeProperty ;
    rdfs:label "MIME-тип"@ru ;
    rdfs:range xsd:string .

kg:method a owl:DatatypeProperty ;
    rdfs:label "Метод извлечения признака"@ru ;
    rdfs:domain kg:FeatureObservation ;
    rdfs:range xsd:string .

kg:movementSpeed a owl:DatatypeProperty ;
    rdfs:label "Скорость передвижения"@ru ;
    rdfs:range xsd:double .

kg:neutralTier a owl:DatatypeProperty ;
    rdfs:label "Уровень нейтрального предмета"@ru ;
    rdfs:range xsd:integer .

kg:normalizedAdvantage a owl:DatatypeProperty ;
    rdfs:label "Отклонение от базовой доли побед"@ru ;
    rdfs:comment "winRate этого матчапа минус winRate общей статистики ТОГО ЖЕ героя. Это описательная оценка по агрегатам, не причинная сила контрпика."@ru ;
    rdfs:range xsd:double .

kg:notesValues a owl:ObjectProperty ;
    rdfs:label "Примечания"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:opponent a owl:ObjectProperty ;
    rdfs:label "Противник"@ru ;
    rdfs:domain kg:MatchupObservation ;
    rdfs:range kg:Hero .

kg:opponentHeroId a owl:DatatypeProperty ;
    rdfs:label "Идентификатор противника"@ru ;
    rdfs:range xsd:integer .

kg:parameterData a owl:ObjectProperty ;
    rdfs:label "Все исходные поля параметра"@ru ;
    rdfs:domain kg:Parameter ;
    rdfs:range kg:JsonValue .

kg:parameterName a owl:DatatypeProperty ;
    rdfs:label "Имя special_values"@ru ;
    rdfs:range xsd:string .

kg:passiveEffect a owl:DatatypeProperty ;
    rdfs:label "Пассивный эффект"@ru ;
    rdfs:range xsd:string .

kg:phase a owl:DatatypeProperty ;
    rdfs:label "Стадия игры"@ru ;
    rdfs:domain kg:ItemUsageObservation ;
    rdfs:range xsd:string .

kg:piercesDebuffImmunity a owl:DatatypeProperty ;
    rdfs:label "Проходит сквозь невосприимчивость к эффектам"@ru ;
    rdfs:range xsd:boolean .

kg:primaryAttribute a owl:DatatypeProperty ;
    rdfs:label "Основная характеристика"@ru ;
    rdfs:range xsd:string .

kg:professionalBans a owl:DatatypeProperty ;
    rdfs:label "Запреты в профессиональных матчах"@ru ;
    rdfs:range xsd:integer .

kg:professionalMatches a owl:DatatypeProperty ;
    rdfs:label "Профессиональные матчи"@ru ;
    rdfs:range xsd:integer .

kg:professionalWins a owl:DatatypeProperty ;
    rdfs:label "Победы в профессиональных матчах"@ru ;
    rdfs:range xsd:integer .

kg:radiusValues a owl:ObjectProperty ;
    rdfs:label "Радиус по уровням"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:rankBracket a owl:DatatypeProperty ;
    rdfs:label "Код рейтингового интервала"@ru ;
    rdfs:domain kg:RankBracketObservation ;
    rdfs:range xsd:string .

kg:rankBracketsValues a owl:ObjectProperty ;
    rdfs:label "Исходная статистика рейтинговых интервалов"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:relativePath a owl:DatatypeProperty ;
    rdfs:label "Путь в репозитории"@ru ;
    rdfs:range xsd:string .

kg:retrievedAtText a owl:DatatypeProperty ;
    rdfs:label "Исходная строка времени получения"@ru ;
    rdfs:range xsd:string .

kg:roleLevelsValues a owl:ObjectProperty ;
    rdfs:label "Уровни ролей"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:scepterDescription a owl:DatatypeProperty ;
    rdfs:label "Описание улучшения Scepter"@ru ;
    rdfs:range xsd:string .

kg:scepterValues a owl:ObjectProperty ;
    rdfs:label "Исходный массив Scepter"@ru ;
    rdfs:domain kg:Parameter ;
    rdfs:range kg:JsonValue .

kg:sha256 a owl:DatatypeProperty ;
    rdfs:label "SHA256 исходных байтов"@ru ;
    rdfs:range xsd:string .

kg:shardDescription a owl:DatatypeProperty ;
    rdfs:label "Описание улучшения Shard"@ru ;
    rdfs:range xsd:string .

kg:shardValues a owl:ObjectProperty ;
    rdfs:label "Исходный массив Shard"@ru ;
    rdfs:domain kg:Parameter ;
    rdfs:range kg:JsonValue .

kg:snapshot a owl:ObjectProperty ;
    rdfs:label "Снимок"@ru ;
    rdfs:range kg:DatasetSnapshot .

kg:source a owl:ObjectProperty ;
    rdfs:label "Источник"@ru ;
    rdfs:range kg:DataSource .

kg:sourceCode a owl:DatatypeProperty ;
    rdfs:label "Исходный код источника"@ru ;
    rdfs:range xsd:string .

kg:sourceIndex a owl:DatatypeProperty ;
    rdfs:label "Исходная позиция"@ru ;
    rdfs:range xsd:integer .

kg:specialValues a owl:ObjectProperty ;
    rdfs:label "Специальные параметры"@ru ;
    rdfs:comment "Упорядоченное структурное значение исходной JSON-колонки; точная исходная строка хранится в архиве."@ru ;
    rdfs:range kg:JsonValue .

kg:strength a owl:DatatypeProperty ;
    rdfs:label "Сила"@ru ;
    rdfs:range xsd:double .

kg:strengthGain a owl:DatatypeProperty ;
    rdfs:label "Прирост силы"@ru ;
    rdfs:range xsd:double .

kg:supportedByAbility a owl:ObjectProperty ;
    rdfs:label "Способность в доказательстве"@ru ;
    rdfs:domain kg:FeatureObservation ;
    rdfs:range kg:Ability .

kg:targetTeam a owl:DatatypeProperty ;
    rdfs:label "Код команды цели"@ru ;
    rdfs:range xsd:integer .

kg:targetType a owl:DatatypeProperty ;
    rdfs:label "Код типа цели"@ru ;
    rdfs:range xsd:integer .

kg:unit a owl:DatatypeProperty ;
    rdfs:label "Единица значения признака"@ru ;
    rdfs:range xsd:string .

kg:usageCount a owl:DatatypeProperty ;
    rdfs:label "Число использований"@ru ;
    rdfs:range xsd:integer .

kg:value a owl:DatatypeProperty ;
    rdfs:label "Числовое значение"@ru ;
    rdfs:range xsd:double .

kg:valueKind a owl:DatatypeProperty ;
    rdfs:label "Тип значения признака"@ru ;
    rdfs:comment "binary, count или numeric. Бинарная единица означает обнаруженный признак; ноль матрицы не доказывает его отсутствие."@ru ;
    rdfs:domain kg:Feature ;
    rdfs:range xsd:string .

kg:winRate a owl:DatatypeProperty ;
    rdfs:label "Доля побед"@ru ;
    rdfs:range xsd:double .

kg:wins a owl:DatatypeProperty ;
    rdfs:label "Точное число побед"@ru ;
    rdfs:range xsd:integer .

kg:DataSource a owl:Class ;
    rdfs:label "Источник данных"@ru ;
    rdfs:comment "Только реально указанный источник. Неизвестный источник остаётся пропуском."@ru .

kg:FeatureVector a owl:Class ;
    rdfs:label "Строка матрицы признаков"@ru ;
    rdfs:comment "Все 76 значений, включая нули. Ноль не является OWL-отрицанием."@ru ;
    rdfs:subClassOf kg:Observation .

kg:HeroSnapshot a owl:Class ;
    rdfs:label "Снимок характеристик героя"@ru ;
    rdfs:comment "Характеристики Valve на момент исходного снимка."@ru ;
    rdfs:subClassOf kg:Observation .

kg:ItemUsageObservation a owl:Class ;
    rdfs:label "Популярность предмета"@ru ;
    rdfs:comment "Число использований на стадии игры; знаменателя и вероятности выбора нет."@ru ;
    rdfs:subClassOf kg:Observation .

kg:SourceArtifact a owl:Class ;
    rdfs:label "Исходный файл"@ru ;
    rdfs:comment "Полное содержимое, относительный путь, формат и SHA256. JSON/CSV сохраняются текстом, Parquet в base64."@ru ;
    rdfs:subClassOf prov:Entity .

kg:AbilitySnapshot a owl:Class ;
    rdfs:label "Снимок способности"@ru ;
    rdfs:comment "Описание, коды механик и массивы параметров способности."@ru ;
    rdfs:subClassOf kg:Observation .

kg:Feature a owl:Class ;
    rdfs:label "Признак"@ru ;
    rdfs:comment "Тип извлекаемого свойства. Не OWL-класс героя."@ru .

kg:HeroStatisticsObservation a owl:Class ;
    rdfs:label "Общая статистика героя"@ru ;
    rdfs:comment "Агрегаты OpenDota. Суммы рейтинговых интервалов не равны автоматически raw pub_pick."@ru ;
    rdfs:subClassOf kg:Observation .

kg:Item a owl:Class ;
    rdfs:label "Предмет"@ru ;
    rdfs:comment "Нормализованный предмет; дополнительные исходные записи сохранены в архиве."@ru ;
    rdfs:subClassOf kg:Entity .

kg:JsonEntry a owl:Class ;
    rdfs:label "Элемент структуры"@ru ;
    rdfs:comment "Ключ объекта или индекс массива и ровно одно скалярное либо вложенное значение."@ru .

kg:MatchupObservation a owl:Class ;
    rdfs:label "Статистика противостояния"@ru ;
    rdfs:comment "Направленное статистическое наблюдение. Не является доказательством причинного контрпика."@ru ;
    rdfs:subClassOf kg:Observation .

kg:RankBracketObservation a owl:Class ;
    rdfs:label "Статистика рейтингового интервала"@ru ;
    rdfs:comment "Показатели одного исходного интервала; названия рангов не выдумываются."@ru ;
    rdfs:subClassOf kg:Observation .

prov:Entity a owl:Class .

kg:Ability a owl:Class ;
    rdfs:label "Способность"@ru ;
    rdfs:comment "Конкретная способность с идентификатором Valve."@ru ;
    rdfs:subClassOf kg:Entity .

kg:DatasetSnapshot a owl:Class ;
    rdfs:label "Снимок всех данных"@ru ;
    rdfs:comment "Идентификатор зависит от SHA256 всех входных файлов."@ru ;
    rdfs:subClassOf prov:Entity .

kg:FeatureObservation a owl:Class ;
    rdfs:label "Извлечённый признак героя"@ru ;
    rdfs:comment "Герой, тип признака, значение, метод и исходное доказательство."@ru ;
    rdfs:subClassOf kg:Observation .

kg:Entity a owl:Class ;
    rdfs:label "Сущность игры"@ru ;
    rdfs:comment "Устойчивая сущность с идентификатором Valve."@ru .

kg:Hero a owl:Class ;
    rdfs:label "Герой"@ru ;
    rdfs:comment "Конкретный герой; изменяемые характеристики хранятся в снимках."@ru ;
    rdfs:subClassOf kg:Entity .

kg:Parameter a owl:Class ;
    rdfs:label "Параметр способности или предмета"@ru ;
    rdfs:comment "Именованный special_values с исходными массивами и модификаторами."@ru .

kg:Observation a owl:Class ;
    rdfs:label "Наблюдение"@ru ;
    rdfs:comment "Факт в конкретном снимке данных; не вечное свойство героя."@ru ;
    rdfs:subClassOf prov:Entity .

kg:JsonValue a owl:Class ;
    rdfs:label "Структурное значение"@ru ;
    rdfs:comment "Структурное значение JSON с явным jsonKind. Ключи объектов, порядок и повторяющиеся элементы массивов, скаляры и null сохранены; точный текст файлов хранится в архиве."@ru .

[] a owl:AllDisjointClasses ;
    owl:members ( kg:Hero kg:Ability kg:Item ) .

