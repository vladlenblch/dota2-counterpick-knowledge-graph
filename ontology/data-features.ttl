<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/record/hero_feature_matrix/11/value/FEAR> a kg:FeatureValue ;
    rdfs:label "Shadow Fiend: FEAR = 1.0"^^xsd:string ;
    kg:evidence "ability Requiem of Souls: Shadow Fiend gathers up to %max_soul_release% of his captured souls to release them as lines of demonic energy. Units near Shadow Fiend when the souls are released can be damaged by several lines of energy. Any unit damaged by Requiem of Souls will be feared and have its movement speed and magic resistance reduced for %requiem_slow_duration% seconds for each line hit up to a maximum of %requiem_slow_duration_max%. Lines of energy are created for every soul capture"^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/FEAR> ;
    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/11> ;
    kg:isObserved true ;
    kg:supportedByAbility <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5064> ;
    kg:value "1.0"^^<http://www.w3.org/2001/XMLSchema#double> .

