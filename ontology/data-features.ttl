    rdfs:label "Chen: GLOBAL_ABILITY = 1.0"^^xsd:string ;
    kg:evidence "ability Holy Persuasion: Chen takes control of an enemy or neutral creep and receives a percentage of its bounty. Its maximum health is set to %health_min%. Converted creeps will have increased movement speed and bonus damage. Chen may globally target his own creep if it has not taken damage in the last %unsummon_time% seconds to unsummon it."^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/GLOBAL_ABILITY> ;
