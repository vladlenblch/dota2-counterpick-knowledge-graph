    rdfs:label "Kez: BKB_PIERCING_DAMAGE = 1.0"^^xsd:string ;
    kg:evidence "ability Kazurai Katana immunity code = 3; Katana attacks and abilities apply a stacking damage over time to enemies that deals a percentage of the original attack's damage as additional damage over time. Kez may activate the ability to impale the target with his attack, preventing them from moving or turning. The target's Katana debuff bursts, causing some of the stacks to deal damage instantly."^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/BKB_PIERCING_DAMAGE> ;
    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/145> ;
