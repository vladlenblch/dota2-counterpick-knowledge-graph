    rdfs:label "Brewmaster: EVASION = 1.0"^^xsd:string ;
    kg:evidence "ability Drunken Brawler: Brewmaster can switch stances based on the elements he controls. Whenever Brewmaster casts an ability, he becomes Brewed Up, increasing his stance power by %brewed_up_bonus%%% for %brewed_up_duration%s. If he casts another ability while Brewed Up, the duration is extended by %brewed_up_duration_extend%s. After Brewed Up expires, he is hungover and cannot Brew Up again for %hangover_time%s. Earth Brawler gains bonus Magic Resistance and Armor. Storm Brawler gains bo"^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/EVASION> ;
    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/78> ;
