    rdfs:label "Templar Assassin: PURE_DAMAGE = 1.0"^^xsd:string ;
    kg:evidence "ability Psi Blades damage code = 4; Templar Assassin's psi blades slice through the attacked unit, splitting and damaging enemy units directly behind it, while gaining bonus attack range. For each unit it damages, the split damage is reduced by a percentage."^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/PURE_DAMAGE> ;
