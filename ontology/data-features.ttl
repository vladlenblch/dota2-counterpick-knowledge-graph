    rdfs:label "Dawnbreaker: GLOBAL_ABILITY = 1.0"^^xsd:string ;
    kg:evidence "ability Solar Guardian: CHANNELED - Dawnbreaker creates a pulsing effect at a location within %max_offset_distance% units of an allied hero anywhere on the map and creates daylight for %daytime_duration%s. Each pulse damages enemies and heals allies. After a short duration, she flies to the target location and deals additional damage and stuns enemies upon landing. Once channeled, Dawnbreaker cannot stop the ability."^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/GLOBAL_ABILITY> ;
    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/135> ;
    kg:isObserved true ;
    kg:supportedByAbility <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/7906> ;
    kg:value "1.0"^^<http://www.w3.org/2001/XMLSchema#double> .

