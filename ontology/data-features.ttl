    rdfs:label "Elder Titan: BKB_PIERCING_DAMAGE = 1.0"^^xsd:string ;
    kg:evidence "ability Astral Spirit immunity code = 3; Elder Titan sends forth his Astral Spirit, damaging any units it passes through. When the spirit rejoins the Titan, it grants bonus damage and movement speed for each unit it passed through. The Astral Spirit possesses the Echo Stomp, Return Spirit, and Natural Order abilities."^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/BKB_PIERCING_DAMAGE> ;
