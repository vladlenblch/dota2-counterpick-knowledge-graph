<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/record/hero_feature_matrix/38/value/HEAL> a kg:FeatureValue ;
    rdfs:label "Beastmaster: HEAL = 1.0"^^xsd:string ;
    kg:evidence "ability Drums of Slom: Attacks from Beastmaster or a nearby unit he controls will cause him bang his drum, dealing damage to nearby units and healing Beastmaster and units under his control for a portion of the damage dealt. Every attack decreases the interval between drum hits down to a minimum of %min_drum_hit_interval%s between hits after %max_stacks% attacks. If no attacks are made, the intervals gradually increase. Using Primal Roar counts as %primal_roar_stacks% attacks."^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/HEAL> ;
    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/38> ;
    kg:isObserved true ;
    kg:supportedByAbility <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1005> ;
    kg:value "1.0"^^<http://www.w3.org/2001/XMLSchema#double> .

