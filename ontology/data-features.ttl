<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/record/hero_feature_matrix/145/value/BKB_PIERCING_CONTROL> a kg:FeatureValue ;
    rdfs:label "Kez: BKB_PIERCING_CONTROL = 1.0"^^xsd:string ;
    kg:evidence "ability Shodo Sai immunity code = 3; Kez has a chance to critically strike the target when attacking with Sais. Kez may activate the ability to disarm himself, lock his facing, and parry attacks and attack effects from the targeted direction for %parry_duration% seconds. If an attack is parried from an enemy Hero in this way, that Hero is stunned for %parry_stun_duration%s and gains a Mark. When a Marked target is attacked by Kez, it will guarantee a critical strike and stun the target. Th"^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/BKB_PIERCING_CONTROL> ;
    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/145> ;
    kg:isObserved true ;
