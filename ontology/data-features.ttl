    rdfs:label "Primal Beast: SLOW = 1.0"^^xsd:string ;
    kg:evidence "ability Uproar: The Beast's temper causes every instance of %damage_limit% hero damage or more to grant a stack of Uproar. When activated, Primal Beast releases a roar that slows surrounding enemies and grants the Beast additional attack damage and armor for %roar_duration% seconds based on his current stacks of Uproar."^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/SLOW> ;
