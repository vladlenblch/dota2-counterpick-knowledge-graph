<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/record/hero_feature_matrix/136/value/HARD_CONTROL> a kg:FeatureValue ;
    rdfs:label "Marci: HARD_CONTROL = 1.0"^^xsd:string ;
    kg:evidence "ability Rebound: Marci bounds to the targeted allied unit, choosing a direction and distance she will spring away from it. Upon reaching the unit, Marci lunges to her final destination, damaging and stunning enemies where she lands. When Rebound is set to alt-cast, Marci brings the target ally with her to her final destination. The ally receives %ally_movespeed_pct%%% bonus movement speed for %ally_buff_duration%s."^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/HARD_CONTROL> ;
    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/136> ;
    kg:isObserved true ;
    kg:supportedByAbility <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/8235> ;
    kg:value "1.0"^^<http://www.w3.org/2001/XMLSchema#double> .

