<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/record/hero_feature_matrix/46/value/BKB_PIERCING_DAMAGE> a kg:FeatureValue ;
    rdfs:label "Templar Assassin: BKB_PIERCING_DAMAGE = 1.0"^^xsd:string ;
    kg:evidence "ability Refraction immunity code = 3; Templar Assassin becomes highly elusive, gaining a small barrier and bonus to her damage. The damage and avoidance effects are separate, and have a limited number of instances. If a barrier is consumed, a new one is created as long as there are charges left. If an instance of damage would deal more damage than the remaining barrier, all of the damage is absorbed."^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/BKB_PIERCING_DAMAGE> ;
    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/46> ;
    kg:isObserved true ;
    kg:supportedByAbility <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/5194> ;
    kg:value "1.0"^^<http://www.w3.org/2001/XMLSchema#double> .

