<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/record/hero_feature_matrix/136/value/HIGH_MOBILITY> a kg:FeatureValue ;
    rdfs:label "Marci: HIGH_MOBILITY = 1.0"^^xsd:string ;
    kg:evidence "ability Special Delivery: Marci whistles to instantly summon her courier to her. If the courier started in the fountain, it will take items from Marci's stash. After teleporting it will transfer these items to Marci and head back to the fountain. Passively grants all allied couriers %bonus_levels% bonus levels and %bonus_hp_tooltip% bonus health."^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/HIGH_MOBILITY> ;
