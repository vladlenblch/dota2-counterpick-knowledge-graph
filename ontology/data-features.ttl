<https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/record/hero_feature_matrix/50/value/HARD_CONTROL> a kg:FeatureValue ;
    rdfs:label "Dazzle: HARD_CONTROL = 1.0"^^xsd:string ;
    kg:evidence "ability Nothl Projection: Dazzle departs his body, traveling through the Nothl Realm as an invulnerable spirit that can cast spells, attack, and use items, leaving his body behind in the world with a visible tether. While active, Dazzle's basic abilities are empowered: Poison Touch hexes enemies, Shallow Grave heals upon expiration, and Shadow Wave has a shorter cooldown. The effect can be ended early, and Dazzle returns to the body at the end."^^xsd:string ;
    kg:feature <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/feature/HARD_CONTROL> ;
    kg:hero <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/hero/50> ;
    kg:isObserved true ;
    kg:supportedByAbility <https://github.com/vladlenblch/dota2-counterpick-knowledge-graph/resource/ability/1550> ;
    kg:value "1.0"^^<http://www.w3.org/2001/XMLSchema#double> .

